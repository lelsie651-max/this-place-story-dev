page {
  background: #efe4d2;
  color: #3d2b1f;
  font-size: 32rpx;
  min-height: 100%;
  font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 40rpx 32rpx 56rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at top, rgba(255, 248, 236, 0.92), rgba(239, 228, 210, 0.92) 48%, rgba(226, 207, 179, 0.96));
}

.section-label {
  margin-bottom: 18rpx;
  color: #8b5e34;
  font-size: 24rpx;
  letter-spacing: 6rpx;
}

.page-title {
  margin-bottom: 18rpx;
  font-size: 56rpx;
  font-weight: 600;
  line-height: 1.25;
}

.page-subtitle {
  margin-bottom: 36rpx;
  color: #6f5740;
  line-height: 1.8;
}

.panel {
  margin-bottom: 28rpx;
  padding: 32rpx;
  background: rgba(255, 250, 242, 0.92);
  border: 1rpx solid rgba(140, 94, 52, 0.12);
  border-radius: 28rpx;
  box-shadow: 0 16rpx 40rpx rgba(108, 74, 45, 0.08);
  backdrop-filter: blur(6rpx);
}

.panel-title {
  margin-bottom: 12rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #4c3424;
}

.panel-text {
  color: #6f5740;
  line-height: 1.8;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(140, 94, 52, 0.12);
  color: #8b5e34;
  font-size: 24rpx;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  margin-top: 12rpx;
}

.action-button {
  width: 100%;
  min-height: 96rpx;
  border: none;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #9b6937, #6b4527);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 96rpx;
  box-shadow: 0 14rpx 30rpx rgba(107, 69, 39, 0.2);
}

.action-button.secondary {
  background: rgba(255, 247, 235, 0.95);
  border: 1rpx solid rgba(140, 94, 52, 0.22);
  color: #6b4527;
  box-shadow: none;
}

.action-button.ghost {
  background: rgba(255, 247, 235, 0.72);
  border: 1rpx dashed rgba(140, 94, 52, 0.36);
  color: #8b5e34;
  box-shadow: none;
}

.page-note {
  margin-top: 18rpx;
  color: #8a725c;
  font-size: 24rpx;
  text-align: center;
}

.muted {
  color: #8a725c;
}
