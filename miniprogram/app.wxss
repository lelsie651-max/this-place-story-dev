page {
  background: #f5f7fb;
  color: #1f2937;
  font-size: 32rpx;
  min-height: 100%;
}

.page {
  min-height: 100vh;
  padding: 48rpx 32rpx;
  box-sizing: border-box;
}

.page-title {
  margin-bottom: 16rpx;
  font-size: 48rpx;
  font-weight: 600;
}

.page-subtitle {
  margin-bottom: 40rpx;
  color: #6b7280;
  line-height: 1.6;
}

.card {
  margin-bottom: 24rpx;
  padding: 32rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 36rpx rgba(15, 23, 42, 0.06);
}

.card-title {
  margin-bottom: 12rpx;
  font-size: 36rpx;
  font-weight: 600;
}

.card-text {
  color: #4b5563;
  line-height: 1.7;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 32rpx;
}

.action-button {
  width: 100%;
  border-radius: 999rpx;
  background: #1d4ed8;
  color: #ffffff;
}

.action-button.secondary {
  background: #e0e7ff;
  color: #1e3a8a;
}
