<view class="page">
  <view class="section-label">STORY VIEW</view>
  <view wx:if="{{loading}}" class="story-card panel">
    <view class="panel-title">正在读取故事</view>
    <view class="panel-text">正在从云端读取已发布内容，请稍等片刻。</view>
  </view>

  <block wx:elif="{{currentStory}}">
    <block wx:if="{{currentStory.isAiGenerated}}">
      <view class="story-forum-card panel">
        <view class="forum-header">
          <view class="forum-avatar {{currentStory.aiPost.avatarPaletteClass}}">
            <text class="forum-avatar-emoji">{{currentStory.aiPost.avatarEmoji}}</text>
          </view>
          <view class="forum-header-main">
            <view class="forum-author-row">
              <text class="forum-display-name">{{currentStory.aiPost.displayName}}</text>
            </view>
            <view class="forum-identity-description">{{currentStory.aiPost.displayRole}}</view>
          </view>
        </view>

        <view class="forum-title" data-design-id="story-page-title">{{currentStory.title}}</view>
        <view class="forum-location" data-design-id="story-summary">📍 {{currentStory.location}}</view>

        <view class="story-content forum-content" data-design-id="story-content">
          <view wx:for="{{contentParagraphs}}" wx:key="index" class="story-paragraph">
            {{item}}
          </view>
        </view>

        <view class="forum-footer">
          <view class="forum-compliance">
            <text class="forum-compliance-text">{{currentStory.aiPost.complianceText}}</text>
          </view>
        </view>
      </view>
    </block>

    <block wx:else>
      <view class="tag">{{currentStory.typeLabel}}</view>
      <view class="page-title story-title" data-design-id="story-page-title">{{currentStory.title}}</view>
      <view class="page-subtitle location-text" data-design-id="story-summary">📍 {{currentStory.location}}</view>

      <view class="story-card panel">
        <view class="panel-title">故事正文</view>
        <view class="story-content" data-design-id="story-content">
          <view wx:for="{{contentParagraphs}}" wx:key="index" class="story-paragraph">
            {{item}}
          </view>
        </view>
      </view>

      <view class="story-meta panel">
        <view wx:if="{{currentStory.transientPlace}}" class="meta-row">
          <text class="meta-label">地点状态</text>
          <text class="meta-value">本次选点临时故事</text>
        </view>
        <view class="meta-row">
          <text class="meta-label">故事来源</text>
          <text class="meta-value">{{currentStory.sourceLabel}}</text>
        </view>
        <view class="meta-row">
          <text class="meta-label">展示模式</text>
          <text class="meta-value">{{currentStory.typeLabel}}</text>
        </view>
      </view>
    </block>

    <view class="actions">
      <button wx:if="{{currentStory.collectible}}" class="action-button" bindtap="handleCollect" loading="{{favoriteSubmitting}}" data-design-id="story-favorite-button">
        {{isFavorited ? '💛 已收藏' : '❤️ 收藏'}}
      </button>
      <button class="action-button secondary" bindtap="backToHome" data-design-id="story-back-button">返回</button>
    </view>

    <view wx:if="{{currentStory.note}}" class="page-note">{{currentStory.note}}</view>
  </block>

  <view wx:else class="story-card panel error-card">
    <view class="panel-title">故事暂时不可用</view>
    <view class="panel-text">{{errorMessage}}</view>
    <view class="actions">
      <button class="action-button secondary" bindtap="backToHome" data-design-id="story-back-button">返回</button>
    </view>
  </view>
</view>
