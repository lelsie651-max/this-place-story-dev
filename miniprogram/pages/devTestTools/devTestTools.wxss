.env-banner,
.section-panel {
  margin-bottom: 28rpx;
}

.env-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(180deg, rgba(255, 248, 236, 0.98), rgba(245, 231, 208, 0.96));
}

.env-banner-label {
  color: #8b5e34;
  font-size: 24rpx;
  letter-spacing: 4rpx;
}

.env-banner-value {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(140, 94, 52, 0.12);
  color: #6b4527;
  font-size: 24rpx;
  font-weight: 600;
}

.empty-panel {
  text-align: center;
}

.empty-title {
  display: block;
  margin-bottom: 12rpx;
  color: #4c3424;
  font-size: 32rpx;
  font-weight: 600;
}

.empty-text,
.section-note {
  color: #8a725c;
  font-size: 24rpx;
  line-height: 1.7;
}

.auth-status {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(140, 94, 52, 0.08);
}

.auth-status-idle {
  background: rgba(140, 94, 52, 0.08);
}

.auth-status-pending {
  background: rgba(182, 120, 51, 0.12);
}

.auth-status-success {
  background: rgba(72, 136, 101, 0.12);
}

.auth-status-error {
  background: rgba(189, 94, 83, 0.12);
}

.auth-status-text {
  flex: 1;
  color: #4c3424;
  font-size: 24rpx;
  line-height: 1.6;
}

.auth-status-badge {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(140, 94, 52, 0.12);
  color: #8b5e34;
  font-size: 20rpx;
}

.section-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 18rpx;
}

.section-title {
  margin-bottom: 18rpx;
  color: #4c3424;
  font-size: 30rpx;
  font-weight: 600;
}

.status-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(140, 94, 52, 0.12);
}

.status-row:last-child {
  border-bottom: none;
}

.status-key {
  color: #8b5e34;
  font-size: 24rpx;
}

.status-value {
  max-width: 60%;
  color: #4c3424;
  font-size: 24rpx;
  text-align: right;
  word-break: break-all;
}

.status-value-multiline {
  line-height: 1.6;
}

.preset-row,
.input-row,
.picker-row,
.action-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 18rpx;
  flex-wrap: wrap;
}

.tool-input {
  flex: 1;
  min-width: 220rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(140, 94, 52, 0.08);
  color: #4c3424;
  font-size: 26rpx;
}

.tool-input-full {
  width: 100%;
  box-sizing: border-box;
}

.picker-value {
  padding: 18rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(140, 94, 52, 0.08);
  color: #4c3424;
  font-size: 26rpx;
}

.story-type-picker {
  flex: 1;
}

.selected-count {
  margin-top: 18rpx;
  color: #6b4527;
  font-size: 24rpx;
}

.preset-button,
.minor-button,
.secondary-button,
.primary-button {
  margin: 0;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.preset-button::after,
.minor-button::after,
.secondary-button::after,
.primary-button::after {
  border: none;
}

.preset-button,
.minor-button,
.secondary-button {
  background: rgba(140, 94, 52, 0.12);
  color: #6b4527;
}

.primary-button {
  background: linear-gradient(180deg, #b67833, #8b5e34);
  color: #fffaf2;
}

.block-button {
  width: 100%;
  margin-top: 20rpx;
}
