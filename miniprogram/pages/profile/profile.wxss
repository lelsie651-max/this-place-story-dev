.profile-header {
  margin-bottom: 36rpx;
  padding-top: 44rpx;
  padding-bottom: 36rpx;
  text-align: center;
  background: linear-gradient(180deg, rgba(255, 248, 236, 0.98), rgba(244, 228, 199, 0.92));
}

.profile-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 132rpx;
  margin: 0 auto 20rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #9b6937, #6b4527);
  color: #fffaf2;
  font-size: 48rpx;
  font-weight: 600;
  box-shadow: 0 16rpx 36rpx rgba(107, 69, 39, 0.18);
}

.profile-name {
  margin-bottom: 12rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: #4c3424;
}

.profile-subtitle {
  color: #7a624c;
}

.asset-panel {
  margin-bottom: 32rpx;
  background: linear-gradient(180deg, rgba(255, 249, 238, 0.98), rgba(246, 232, 208, 0.96));
}

.asset-label,
.function-label {
  margin-bottom: 18rpx;
  color: #8b5e34;
  font-size: 24rpx;
  letter-spacing: 4rpx;
}

.asset-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.asset-item-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.asset-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background: rgba(140, 94, 52, 0.12);
  color: #8b5e34;
  font-size: 36rpx;
  line-height: 76rpx;
  text-align: center;
}

.asset-name {
  margin-bottom: 8rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #4c3424;
}

.asset-note {
  max-width: 360rpx;
  color: #7a624c;
  font-size: 24rpx;
  line-height: 1.6;
}

.asset-value {
  text-align: center;
}

.asset-number {
  font-size: 58rpx;
  font-weight: 600;
  color: #6b4527;
  line-height: 1.1;
}

.asset-unit {
  color: #8b5e34;
  font-size: 24rpx;
}

.menu-list {
  display: flex;
  flex-direction: column;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 28rpx;
  padding-bottom: 28rpx;
}

.menu-item-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.menu-icon {
  width: 64rpx;
  text-align: center;
  font-size: 34rpx;
}

.menu-label {
  font-size: 32rpx;
  color: #4c3424;
}

.menu-subtext {
  margin-top: 6rpx;
  color: #8a725c;
  font-size: 22rpx;
}

.menu-item-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.menu-count {
  min-width: 44rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(140, 94, 52, 0.12);
  color: #8b5e34;
  font-size: 22rpx;
  text-align: center;
}

.menu-arrow {
  color: #9d856d;
  font-size: 42rpx;
}
