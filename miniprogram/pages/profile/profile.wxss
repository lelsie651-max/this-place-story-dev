.profile-header {
  margin-bottom: 36rpx;
  padding-top: 44rpx;
  padding-bottom: 36rpx;
  text-align: center;
  background: linear-gradient(180deg, rgba(255, 248, 236, 0.98), rgba(244, 228, 199, 0.92));
}

.profile-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 132rpx;
  margin: 0 auto 20rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #9b6937, #6b4527);
  color: #fffaf2;
  font-size: 48rpx;
  font-weight: 600;
  box-shadow: 0 16rpx 36rpx rgba(107, 69, 39, 0.18);
}

.profile-name {
  margin-bottom: 12rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: #4c3424;
}

.profile-subtitle {
  color: #7a624c;
}

.menu-list {
  display: flex;
  flex-direction: column;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 28rpx;
  padding-bottom: 28rpx;
}

.menu-item-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.menu-icon {
  width: 64rpx;
  text-align: center;
  font-size: 34rpx;
}

.menu-label {
  font-size: 32rpx;
  color: #4c3424;
}

.menu-arrow {
  color: #9d856d;
  font-size: 42rpx;
}
