.page {
  position: relative;
  min-height: 100vh;
  background: #efe4d2;
}

.profile-background-image {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  z-index: 0;
}

.profile-content {
  position: relative;
  z-index: 1;
}

.visual-card {
  position: relative;
  overflow: hidden;
}

.visual-card__image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.visual-card__content {
  position: relative;
  z-index: 1;
  width: 100%;
  box-sizing: border-box;
}

.profile-header {
  margin-bottom: 32rpx;
  padding-top: 46rpx;
  padding-bottom: 38rpx;
  text-align: center;
  background: transparent;
}

.profile-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 132rpx;
  margin: 0 auto 22rpx;
  border-radius: 50%;
  background: rgba(139, 94, 52, 0.92);
  color: #fffaf2;
  font-size: 48rpx;
  font-weight: 600;
  box-shadow: 0 16rpx 36rpx rgba(107, 69, 39, 0.18);
}

.profile-name {
  margin-bottom: 10rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: #4c3424;
}

.profile-subtitle {
  max-width: 480rpx;
  margin: 0 auto;
  color: #7a624c;
  line-height: 1.7;
}

.asset-panel {
  margin-bottom: 32rpx;
  background: transparent;
}

.asset-label,
.function-label {
  margin-bottom: 18rpx;
  color: #8b5e34;
  font-size: 24rpx;
  letter-spacing: 4rpx;
}

.asset-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.asset-item-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-width: 0;
  flex: 1;
}

.asset-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background: rgba(140, 94, 52, 0.12);
  color: #8b5e34;
  font-size: 36rpx;
  line-height: 76rpx;
  text-align: center;
}

.asset-name {
  margin-bottom: 8rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #4c3424;
  line-height: 1.4;
}

.asset-note {
  max-width: 100%;
  color: #7a624c;
  font-size: 24rpx;
  line-height: 1.6;
}

.asset-value {
  flex-shrink: 0;
  text-align: center;
}

.asset-number {
  font-size: 58rpx;
  font-weight: 600;
  color: #6b4527;
  line-height: 1.1;
}

.asset-unit {
  color: #8b5e34;
  font-size: 24rpx;
}

.reward-divider {
  height: 2rpx;
  margin: 28rpx 0;
  background: rgba(140, 94, 52, 0.12);
}

.reward-panel {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.reward-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.reward-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #4c3424;
}

.reward-note {
  margin-top: 8rpx;
  color: #8a725c;
  font-size: 22rpx;
  line-height: 1.6;
}

.reward-badge {
  min-width: 72rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(190, 122, 36, 0.12);
  color: #8b5e34;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}

.reward-button {
  position: relative;
  overflow: hidden;
  width: 100%;
  min-height: 88rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  border: none;
  background: transparent;
  color: #fffaf2;
  font-size: 28rpx;
  line-height: 1.5;
  box-shadow: 0 12rpx 26rpx rgba(107, 69, 39, 0.14);
}

.reward-button::after {
  border: none;
}

.reward-button-disabled {
  color: #8a725c;
}

.reward-button-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: inherit;
  z-index: 0;
}

.reward-button-label {
  position: relative;
  z-index: 1;
}

.reward-button-disabled .reward-button-image {
  opacity: 0.38;
}

.menu-list {
  display: flex;
  flex-direction: column;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 132rpx;
  padding-top: 26rpx;
  padding-bottom: 26rpx;
  box-sizing: border-box;
}

.menu-item-content,
.dev-tools-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: inherit;
}

.menu-item-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}

.menu-item-left > view:last-child {
  flex: 1;
  min-width: 0;
}

.menu-icon {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: rgba(140, 94, 52, 0.12);
  font-size: 34rpx;
}

.menu-label {
  font-size: 32rpx;
  color: #4c3424;
  line-height: 1.45;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-subtext {
  margin-top: 6rpx;
  color: #8a725c;
  font-size: 22rpx;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-item-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.menu-count {
  min-width: 48rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(140, 94, 52, 0.12);
  color: #8b5e34;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.2;
  text-align: center;
}

.menu-arrow {
  color: #9d856d;
  font-size: 42rpx;
}

.dev-tools-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
  min-height: 132rpx;
  padding-top: 26rpx;
  padding-bottom: 26rpx;
  box-sizing: border-box;
  background: transparent;
}

.dev-tools-main {
  flex: 1;
}

.dev-tools-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.dev-tools-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #4c3424;
}

.dev-tools-badge {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(140, 94, 52, 0.12);
  color: #8b5e34;
  font-size: 20rpx;
}

.dev-tools-note {
  margin-top: 10rpx;
  color: #8a725c;
  font-size: 22rpx;
  line-height: 1.6;
}

.dev-tools-arrow {
  margin-left: 20rpx;
  color: #9d856d;
  font-size: 42rpx;
}
