<view class="page">
  <view class="section-label">PROFILE</view>
  <view class="profile-header panel">
    <view class="profile-avatar">旅</view>
    <view class="profile-name">旅行探索者</view>
    <view class="profile-subtitle">在每个地点留下自己的故事线索。</view>
  </view>

  <view class="page-title">个人中心</view>
  <view class="page-subtitle">
    在这里查看你的收藏、图鉴和当前可用资源。
  </view>

  <view class="asset-panel panel">
    <view class="asset-label">用户资产</view>
    <view class="asset-item">
      <view class="asset-item-left">
        <view class="asset-icon">🔍</view>
        <view>
          <view class="asset-name">放大镜</view>
          <view class="asset-note">用于未来探索和地点互动的个人资源</view>
        </view>
      </view>
      <view class="asset-value">
        <view class="asset-number">{{magnifyingGlass}}</view>
        <view class="asset-unit">枚</view>
      </view>
    </view>
  </view>

  <view class="function-label">功能入口</view>
  <view class="menu-list">
    <view
      wx:for="{{menuItems}}"
      wx:key="key"
      class="menu-item panel"
      data-route="{{item.route}}"
      bindtap="handleMenuTap"
    >
      <view class="menu-item-left">
        <view class="menu-icon">{{item.icon}}</view>
        <view>
          <view class="menu-label">{{item.label}}</view>
          <view wx:if="{{item.key === 'favorites'}}" class="menu-subtext">
            已收藏 {{favoriteCount}} 条
          </view>
        </view>
      </view>
      <view class="menu-item-right">
        <view wx:if="{{item.key === 'favorites'}}" class="menu-count">{{favoriteCount}}</view>
        <view class="menu-arrow">›</view>
      </view>
    </view>
  </view>
</view>
