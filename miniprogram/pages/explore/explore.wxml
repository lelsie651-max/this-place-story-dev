<view class="page">
  <view class="section-label">MODE SELECT</view>
  <view class="page-title">寻找传说</view>
  <view class="page-subtitle">
    你想听哪一种故事？同一个地点，换一个叙述角度，气质就会完全不同。
  </view>

  <view
    wx:for="{{storyModes}}"
    wx:key="key"
    class="mode-card panel {{item.featured ? 'featured' : ''}} {{!item.enabled ? 'disabled' : ''}}"
    data-type="{{item.key}}"
    data-enabled="{{item.enabled}}"
    bindtap="goToDiscovery"
  >
    <view class="mode-top">
      <view class="mode-title-wrap">
        <view class="panel-title">{{item.title}}</view>
        <view wx:if="{{item.featured}}" class="tag">推荐</view>
      </view>
      <view wx:if="{{item.statusText}}" class="mode-status">{{item.statusText}}</view>
    </view>

    <view class="panel-text">
      {{item.description}}
    </view>

    <view class="mode-footer">
      <text class="mode-entry">{{item.enabled ? '进入地点发现' : '敬请期待'}}</text>
    </view>
  </view>
</view>
