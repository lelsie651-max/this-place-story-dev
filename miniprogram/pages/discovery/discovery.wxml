<view class="page">
  <view class="hero">
    <view class="hero-title" data-design-id="discovery-page-title">选择地点</view>
    <view class="section-label hero-english">LOCATION DISCOVERY</view>
  </view>

  <view class="location-entry panel">
    <button class="choose-location-button" bindtap="handleChooseLocation" loading="{{chooseLocationLoading}}" data-design-id="discovery-search-input">
      选择你的位置
    </button>
  </view>

  <view class="location-section-title">看看其他有意思的地方！</view>

  <block wx:if="{{loading}}">
    <view class="mode-card panel">
      <view class="panel-title">正在寻找地点</view>
      <view class="panel-text">正在从云端读取推荐地点，请稍等片刻。</view>
    </view>
  </block>

  <block wx:elif="{{errorMessage}}">
    <view class="mode-card panel empty-card">
      <view class="panel-title">地点暂时不可用</view>
      <view class="panel-text">{{errorMessage}}</view>
    </view>
  </block>

  <block wx:elif="{{emptyState}}">
    <view class="mode-card panel empty-card" data-design-id="discovery-empty-state">
      <view class="panel-title">暂时没有新的线索</view>
      <view class="panel-text">{{emptyMessage}}</view>
    </view>
  </block>

  <block wx:else>
    <view
      wx:for="{{filteredLocations}}"
      wx:key="id"
      class="mode-card panel"
      data-design-id="discovery-location-card"
      data-location-id="{{item.id}}"
      bindtap="goToLocation"
    >
      <view class="mode-top">
        <view class="mode-title-wrap">
          <view class="panel-title">{{item.title}}</view>
          <view wx:if="{{item.showNew || item.showHot}}" class="location-badges">
            <view wx:if="{{item.showNew}}" class="location-badge-new">NEW</view>
            <view wx:if="{{item.showHot}}" class="location-badge-hot">HOT</view>
          </view>
        </view>
      </view>

      <view class="panel-text">
        {{item.description}}
      </view>

      <view class="mode-footer">
        <text class="mode-entry">点击查看</text>
      </view>
    </view>
  </block>
</view>
