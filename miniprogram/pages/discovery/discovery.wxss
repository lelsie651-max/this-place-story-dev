.hero {
  margin-bottom: 40rpx;
  padding-top: 12rpx;
  text-align: center;
}

.hero-title {
  margin-bottom: 16rpx;
  font-size: 68rpx;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: 2rpx;
  color: #412a1f;
  text-align: center;
}

.hero-english {
  display: block;
  margin-bottom: 8rpx;
  color: rgba(139, 94, 52, 0.58);
  font-size: 18rpx;
  font-weight: 400;
  line-height: 1.2;
  letter-spacing: 6rpx;
  text-align: center;
}

.location-entry {
  margin-bottom: 32rpx;
}

.choose-location-button {
  min-height: 88rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(140, 94, 52, 0.18);
  border-radius: 999rpx;
  background: linear-gradient(180deg, rgba(255, 249, 241, 0.98), rgba(246, 234, 214, 0.96));
  color: #6b4527;
  font-size: 28rpx;
  line-height: 1.4;
  box-shadow: 0 14rpx 30rpx rgba(107, 69, 39, 0.08);
}

.location-section-title {
  margin-bottom: 22rpx;
  color: #5b3922;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.7;
}

.mode-card {
  position: relative;
  overflow: hidden;
  background: linear-gradient(180deg, rgba(255, 251, 244, 0.98), rgba(249, 240, 226, 0.94));
}

.mode-card::after {
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  width: 120rpx;
  height: 120rpx;
  background: radial-gradient(circle, rgba(183, 132, 77, 0.15), rgba(183, 132, 77, 0));
}

.mode-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 16rpx;
}

.mode-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.location-badges {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
}

.location-badge-new {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(140, 94, 52, 0.12);
  color: #8b5e34;
  font-size: 20rpx;
  line-height: 1.4;
}

.location-badge-hot {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(169, 90, 90, 0.12);
  color: #8a4d4d;
  font-size: 20rpx;
  line-height: 1.4;
}

.mode-footer {
  margin-top: 24rpx;
}

.mode-entry {
  position: relative;
  display: inline-flex;
  align-items: center;
  padding-right: 28rpx;
  color: #8b5e34;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.5;
}

.mode-entry::after {
  content: "›";
  position: absolute;
  right: 0;
}
