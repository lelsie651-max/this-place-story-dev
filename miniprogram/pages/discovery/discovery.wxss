.search-panel {
  margin-bottom: 24rpx;
}

.search-box {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.search-input {
  flex: 1;
  min-height: 84rpx;
  padding: 0 28rpx;
  border: 1rpx solid rgba(140, 94, 52, 0.18);
  border-radius: 999rpx;
  background: rgba(255, 249, 241, 0.96);
  color: #4c3424;
  font-size: 28rpx;
  box-sizing: border-box;
}

.clear-button {
  flex-shrink: 0;
  min-width: 96rpx;
  padding: 18rpx 0;
  color: #8b5e34;
  font-size: 26rpx;
  text-align: center;
}

.search-hint {
  margin-top: 16rpx;
  color: #8a725c;
  font-size: 24rpx;
  line-height: 1.7;
}

.choose-location-button {
  margin-top: 20rpx;
  border: 1rpx solid rgba(140, 94, 52, 0.18);
  border-radius: 999rpx;
  background: linear-gradient(180deg, rgba(255, 249, 241, 0.98), rgba(246, 234, 214, 0.96));
  color: #6b4527;
  font-size: 28rpx;
  line-height: 84rpx;
  box-shadow: 0 12rpx 28rpx rgba(107, 69, 39, 0.08);
}

.mode-card {
  position: relative;
  overflow: hidden;
}

.mode-card::after {
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  width: 120rpx;
  height: 120rpx;
  background: radial-gradient(circle, rgba(183, 132, 77, 0.15), rgba(183, 132, 77, 0));
}

.mode-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.mode-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.mode-status {
  color: #a08873;
  font-size: 24rpx;
}

.mode-footer {
  margin-top: 28rpx;
  color: #8b5e34;
  font-size: 28rpx;
}

.mode-entry {
  position: relative;
  padding-right: 28rpx;
}

.mode-entry::after {
  content: "›";
  position: absolute;
  right: 0;
}

.featured {
  background: linear-gradient(180deg, rgba(255, 248, 236, 0.98), rgba(244, 228, 199, 0.92));
  border-color: rgba(155, 105, 55, 0.24);
}

.disabled {
  opacity: 0.72;
}
