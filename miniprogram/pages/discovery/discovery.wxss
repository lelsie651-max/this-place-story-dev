.hero {
  margin-bottom: 36rpx;
  text-align: center;
}

.hero-title {
  margin-bottom: 14rpx;
  font-size: 72rpx;
  font-weight: 600;
  line-height: 1.2;
  color: #412a1f;
  text-align: center;
}

.hero-english {
  display: block;
  margin-bottom: 12rpx;
  color: rgba(139, 94, 52, 0.58);
  font-size: 20rpx;
  font-weight: 400;
  line-height: 1.2;
  letter-spacing: 6rpx;
  text-align: center;
}

.location-entry {
  margin-bottom: 28rpx;
}

.choose-location-button {
  border: 1rpx solid rgba(140, 94, 52, 0.18);
  border-radius: 999rpx;
  background: linear-gradient(180deg, rgba(255, 249, 241, 0.98), rgba(246, 234, 214, 0.96));
  color: #6b4527;
  font-size: 28rpx;
  line-height: 84rpx;
  box-shadow: 0 12rpx 28rpx rgba(107, 69, 39, 0.08);
}

.location-section-title {
  margin-bottom: 20rpx;
  color: #5b3922;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.5;
}

.mode-card {
  position: relative;
  overflow: hidden;
}

.mode-card::after {
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  width: 120rpx;
  height: 120rpx;
  background: radial-gradient(circle, rgba(183, 132, 77, 0.15), rgba(183, 132, 77, 0));
}

.mode-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.mode-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.location-badges {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
}

.location-badge-new {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(62, 130, 196, 0.12);
  color: #3e82c4;
  font-size: 20rpx;
  line-height: 1.4;
}

.location-badge-hot {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(201, 87, 77, 0.12);
  color: #c9574d;
  font-size: 20rpx;
  line-height: 1.4;
}

.mode-footer {
  margin-top: 28rpx;
  color: #8b5e34;
  font-size: 28rpx;
}

.mode-entry {
  position: relative;
  padding-right: 28rpx;
}

.mode-entry::after {
  content: "›";
  position: absolute;
  right: 0;
}
