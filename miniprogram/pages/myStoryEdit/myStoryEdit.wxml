<view class="page">
  <view class="section-label">EDIT STORY</view>
  <view class="page-title">编辑投稿</view>
  <view class="page-subtitle">你可以修改标题和正文，地点保持为原投稿地点。</view>

  <block wx:if="{{loading}}">
    <view class="panel state-card">
      <view class="panel-title">正在加载投稿</view>
      <view class="panel-text">请稍等，我们正在准备可编辑内容。</view>
    </view>
  </block>

  <block wx:elif="{{errorMessage}}">
    <view class="panel state-card state-card--error">
      <view class="panel-title">当前投稿暂不可编辑</view>
      <view class="panel-text">{{errorMessage}}</view>
    </view>
    <button class="action-button action-button--ghost" bindtap="cancelEdit">返回</button>
  </block>

  <block wx:elif="{{story}}">
    <view class="panel field-card">
      <view class="field-label">投稿地点</view>
      <view class="field-value">{{locationName}}</view>
      <view wx:if="{{locationAddress}}" class="field-address">{{locationAddress}}</view>
    </view>

    <view class="panel field-card">
      <view class="field-label">传说标题</view>
      <input
        class="text-input"
        placeholder="给你的故事起一个名字"
        value="{{storyTitle}}"
        bindinput="onTitleInput"
        maxlength="40"
      />
      <view class="field-note">标题不超过 40 字。</view>
    </view>

    <view class="panel field-card">
      <view class="field-label">故事内容</view>
      <textarea
        class="text-area"
        placeholder="写下你想重新提交审核的故事内容"
        value="{{storyContent}}"
        bindinput="onContentInput"
        maxlength="2000"
      />
      <view class="field-note">正文不超过 2000 字。</view>
    </view>

    <view class="action-group">
      <button class="action-button" bindtap="submitEdit" loading="{{submitting}}">确认提交</button>
      <button class="action-button action-button--ghost" bindtap="cancelEdit">取消</button>
    </view>
  </block>
</view>
