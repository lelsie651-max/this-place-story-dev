<view class="page">
  <view class="section-label">MY STORY</view>
  <view class="page-title">投稿预览</view>
  <view class="page-subtitle">这里展示你提交给审核队列的原始内容。</view>

  <block wx:if="{{loading}}">
    <view class="panel state-card">
      <view class="panel-title">正在加载投稿详情</view>
      <view class="panel-text">请稍等，我们正在读取你的投稿内容。</view>
    </view>
  </block>

  <block wx:elif="{{errorMessage}}">
    <view class="panel state-card state-card--error">
      <view class="panel-title">投稿详情暂时不可用</view>
      <view class="panel-text">{{errorMessage}}</view>
    </view>
    <button class="action-button action-button--ghost" bindtap="goBack">返回</button>
  </block>

  <block wx:elif="{{story}}">
    <view wx:if="{{noticeMessage}}" class="panel notice-card">
      <view class="panel-text">{{noticeMessage}}</view>
    </view>

    <view
      wx:if="{{story.status === 'rejected' && story.rejectionReason}}"
      class="panel story-reason-banner"
    >拒绝原因：{{story.rejectionReason}}</view>

    <view class="panel story-card">
      <view class="story-header">
        <view class="story-title">{{story.title}}</view>
        <view class="story-status status-{{story.status}}">{{story.statusLabel}}</view>
      </view>
      <view wx:if="{{story.locationName}}" class="story-location">{{story.locationName}}</view>
      <view wx:if="{{story.locationAddress}}" class="story-address">{{story.locationAddress}}</view>
      <view class="story-time">{{story.createdAtText}}</view>
      <view class="story-content">{{story.content}}</view>
    </view>

    <view class="action-group">
      <button
        wx:if="{{story.canEdit}}"
        class="action-button"
        bindtap="openEditPage"
      >编辑</button>
      <button
        wx:else
        class="action-button action-button--disabled"
        disabled="true"
      >当前状态不可编辑</button>
      <button
        wx:if="{{story.canDelete}}"
        class="action-button action-button--danger"
        bindtap="deleteStory"
        disabled="{{deleting}}"
      >{{deleting ? '删除中...' : '删除投稿'}}</button>
      <button class="action-button action-button--ghost" bindtap="goBack">返回</button>
    </view>
  </block>
</view>
