<view class="page">
  <view class="section-label">PUBLISH</view>
  <view class="page-title">分享你的传说</view>

  <view class="panel field-card" bindtap="chooseLocation">
    <view class="field-label">📍 选择地点</view>
    <view class="field-value">{{locationName || ''}}</view>
    <view wx:if="{{locationAddress}}" class="field-address">{{locationAddress}}</view>
    <view wx:if="{{latitude !== null && longitude !== null}}" class="field-note">坐标：{{latitude}}, {{longitude}}</view>
    <view wx:if="{{locationName && !isTemporary && locationId}}" class="field-note">当前地点会绑定到已有地点库中的正式地点。</view>
    <view wx:elif="{{locationName && isTemporary}}" class="field-note">当前地点会按临时投稿写入审核队列，不会伪造正式 locationId。</view>
  </view>

  <view class="panel field-card">
    <view class="field-label">传说标题</view>
    <input
      class="text-input"
      placeholder="给你的故事起一个名字"
      value="{{storyTitle}}"
      bindinput="onTitleInput"
      maxlength="40"
    />
    <view class="field-note">标题不超过 40 字。</view>
  </view>

  <view class="panel field-card">
    <view class="field-label">故事内容</view>
    <textarea
      class="text-area"
      placeholder="写下你听来的故事，或你在这里感受到的传说。"
      value="{{storyContent}}"
      bindinput="onContentInput"
      maxlength="2000"
    />
    <view class="field-note">正文不超过 2000 字。</view>
  </view>

  <button class="action-button" bindtap="submitStory" loading="{{submitting}}">提交内容</button>
</view>
