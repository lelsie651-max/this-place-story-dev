<view class="page">
  <view class="section-label">PUBLISH</view>
  <view class="page-title" data-design-id="publish-page-title">分享你的传说</view>

  <view class="panel field-card" bindtap="chooseLocation" data-design-id="publish-location-selector">
    <view class="field-label">📍 选择地点</view>
    <view class="field-value">{{locationName || ''}}</view>
    <view wx:if="{{locationAddress}}" class="field-address">{{locationAddress}}</view>
  </view>

  <view class="panel field-card">
    <view class="field-label">传说标题</view>
    <input
      class="text-input"
      data-design-id="publish-title-input"
      placeholder="给你的故事起一个名字"
      value="{{storyTitle}}"
      bindinput="onTitleInput"
      maxlength="40"
    />
    <view class="field-note">标题不超过 40 字。</view>
  </view>

  <view class="panel field-card">
    <view class="field-label">故事内容</view>
    <textarea
      class="text-area"
      data-design-id="publish-content-input"
      placeholder="写下你听来的故事，或你在这里感受到的传说。"
      value="{{storyContent}}"
      bindinput="onContentInput"
      maxlength="2000"
    />
    <view class="field-note">正文不超过 2000 字。</view>
  </view>

  <button class="action-button" bindtap="submitStory" loading="{{submitting}}" data-design-id="publish-submit-button">提交内容</button>
</view>
