.field-card {
  padding-top: 34rpx;
  padding-bottom: 34rpx;
  background: linear-gradient(180deg, rgba(255, 251, 244, 0.98), rgba(249, 240, 226, 0.94));
}

.field-label {
  margin-bottom: 16rpx;
  color: #8b5e34;
  font-size: 26rpx;
  line-height: 1.5;
}

.field-value {
  margin-bottom: 12rpx;
  font-size: 38rpx;
  font-weight: 600;
  color: #4c3424;
  line-height: 1.45;
}

.field-address {
  margin-bottom: 12rpx;
  color: #6f5740;
  font-size: 26rpx;
  line-height: 1.7;
}

.field-note {
  margin-top: 16rpx;
  color: #7a624c;
  font-size: 24rpx;
  line-height: 1.7;
}

.text-input,
.text-area {
  width: 100%;
  border: 1rpx solid rgba(140, 94, 52, 0.12);
  border-radius: 22rpx;
  background: rgba(255, 247, 235, 0.92);
  color: #4c3424;
  box-sizing: border-box;
  box-shadow: inset 0 2rpx 10rpx rgba(140, 94, 52, 0.04);
}

.text-input {
  min-height: 96rpx;
  padding: 0 24rpx;
  line-height: 96rpx;
}

.text-area {
  min-height: 320rpx;
  padding: 24rpx;
  line-height: 1.8;
}
