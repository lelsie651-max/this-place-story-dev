.top-bar {
  margin-bottom: 20rpx;
}

.back-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 144rpx;
  min-height: 72rpx;
  margin: 0;
  padding: 0 28rpx;
  border: 1rpx solid rgba(140, 94, 52, 0.18);
  border-radius: 999rpx;
  background: rgba(255, 247, 235, 0.92);
  color: #6b4527;
  font-size: 28rpx;
  line-height: 72rpx;
  box-shadow: 0 10rpx 24rpx rgba(107, 69, 39, 0.08);
}

.story-card,
.empty-card,
.error-card {
  background: linear-gradient(180deg, rgba(255, 251, 244, 0.98), rgba(249, 240, 226, 0.94));
}

.story-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.story-title {
  flex: 1;
  color: #4c3424;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.5;
}

.story-status {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  white-space: nowrap;
}

.status-pending {
  background: rgba(201, 146, 89, 0.16);
  color: #8b5e34;
}

.status-published {
  background: rgba(95, 148, 108, 0.16);
  color: #497355;
}

.status-rejected {
  background: rgba(169, 90, 90, 0.14);
  color: #8a4d4d;
}

.story-location {
  margin-top: 14rpx;
  color: #8b5e34;
  font-size: 26rpx;
}

.story-content {
  margin-top: 18rpx;
  color: #6f5740;
  font-size: 28rpx;
  line-height: 1.8;
}
