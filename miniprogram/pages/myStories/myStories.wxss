.story-card,
.empty-card,
.error-card {
  background: linear-gradient(180deg, rgba(255, 251, 244, 0.98), rgba(249, 240, 226, 0.94));
}

.story-card {
  position: relative;
  padding-top: 36rpx;
  padding-bottom: 34rpx;
}

.story-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.story-title {
  flex: 1;
  color: #4c3424;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.5;
  word-break: break-word;
}

.story-status {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.status-pending {
  background: rgba(201, 146, 89, 0.16);
  color: #8b5e34;
}

.status-published {
  background: rgba(95, 148, 108, 0.16);
  color: #497355;
}

.status-rejected {
  background: rgba(169, 90, 90, 0.14);
  color: #8a4d4d;
}

.status-hidden {
  background: rgba(102, 112, 132, 0.16);
  color: #58627a;
}

.story-location {
  margin-top: 16rpx;
  color: #8b5e34;
  font-size: 26rpx;
  line-height: 1.6;
}

.story-time {
  margin-top: 20rpx;
  color: #7a624c;
  font-size: 24rpx;
  line-height: 1.7;
}

.empty-card,
.error-card {
  text-align: center;
}
