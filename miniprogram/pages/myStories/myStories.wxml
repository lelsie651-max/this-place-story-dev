<view class="page">
  <view class="section-label">MY STORIES</view>
  <view class="page-title">我的投稿</view>
  <view class="page-subtitle">这里会显示你已提交的故事，以及当前审核状态。</view>

  <block wx:if="{{loading}}">
    <view class="panel">
      <view class="panel-title">正在加载投稿记录</view>
      <view class="panel-text">请稍等，我们正在读取你自己的投稿。</view>
    </view>
  </block>

  <block wx:elif="{{errorMessage}}">
    <view class="panel error-card">
      <view class="panel-title">投稿记录暂时不可用</view>
      <view class="panel-text">{{errorMessage}}</view>
    </view>
  </block>

  <block wx:elif="{{stories.length === 0}}">
    <view class="panel empty-card">
      <view class="panel-title">你还没有分享过故事哦</view>
      <view class="panel-text">从首页或地点页进入分享页后，就能把自己的地点故事提交进审核队列。</view>
    </view>
  </block>

  <block wx:else>
    <view
      wx:for="{{stories}}"
      wx:key="id"
      class="panel story-card"
      bindtap="openStoryPreview"
      data-story-id="{{item.id}}"
    >
      <view class="story-header">
        <view class="story-title">{{item.title}}</view>
        <view class="story-status status-{{item.status}}">{{item.statusLabel}}</view>
      </view>
      <view wx:if="{{item.locationName}}" class="story-location">{{item.locationName}}</view>
      <view class="story-time">{{item.createdAtText}}</view>
    </view>
  </block>
</view>
