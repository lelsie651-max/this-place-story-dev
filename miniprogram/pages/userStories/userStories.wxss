.top-bar {
  margin-bottom: 20rpx;
}

.back-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 144rpx;
  min-height: 72rpx;
  margin: 0;
  padding: 0 28rpx;
  border: 1rpx solid rgba(140, 94, 52, 0.18);
  border-radius: 999rpx;
  background: rgba(255, 247, 235, 0.92);
  color: #6b4527;
  font-size: 28rpx;
  line-height: 72rpx;
  box-shadow: 0 10rpx 24rpx rgba(107, 69, 39, 0.08);
}

.hero-card,
.stories-card,
.empty-card,
.error-card {
  background: linear-gradient(180deg, rgba(255, 251, 244, 0.98), rgba(249, 240, 226, 0.94));
}

.page-title--compact {
  margin-top: 18rpx;
  margin-bottom: 10rpx;
}

.submission-note {
  margin-top: 16rpx;
  color: #8b5e34;
  font-size: 26rpx;
  line-height: 1.8;
}

.story-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(140, 94, 52, 0.12);
}

.story-item:first-child {
  padding-top: 10rpx;
}

.story-item:last-child {
  padding-bottom: 0;
  border-bottom: none;
}

.story-title {
  color: #4c3424;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.5;
}

.story-summary {
  margin-top: 14rpx;
  color: #6f5740;
  font-size: 28rpx;
  line-height: 1.8;
}

.empty-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.action-secondary {
  flex: 1;
  margin: 0;
  min-height: 80rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(140, 94, 52, 0.18);
  background: rgba(255, 247, 235, 0.92);
  color: #6b4527;
  font-size: 28rpx;
  line-height: 80rpx;
}

.action-primary {
  background: linear-gradient(135deg, #c99259, #ad7340);
  color: #fffaf2;
  border-color: transparent;
}
