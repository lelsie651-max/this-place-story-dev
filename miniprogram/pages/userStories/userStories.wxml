<view class="page">
  <block wx:if="{{loading}}">
    <view class="section-label">TRAVELER STORIES</view>
    <view class="panel">
      <view class="panel-title">正在整理网友故事</view>
      <view class="panel-text">正在读取这个地点已经公开的网友投稿，请稍等片刻。</view>
    </view>
  </block>

  <block wx:elif="{{errorMessage}}">
    <view class="section-label">TRAVELER STORIES</view>
    <view class="panel error-card">
      <view class="panel-title">网友故事暂时不可用</view>
      <view class="panel-text">{{errorMessage}}</view>
    </view>
  </block>

  <block wx:else>
    <view class="section-label">TRAVELER STORIES</view>
    <view class="panel hero-card">
      <view class="page-title page-title--compact">{{locationContext.locationName || '当前地点'}}</view>
      <view wx:if="{{locationContext.address}}" class="page-subtitle">{{locationContext.address}}</view>
      <view wx:if="{{submissionNotice}}" class="submission-note">{{submissionNotice}}</view>
    </view>

    <block wx:if="{{stories.length > 0}}">
      <view class="panel stories-card">
        <view class="panel-title">已公开的网友故事</view>
        <view
          wx:for="{{stories}}"
          wx:key="id"
          class="story-item"
          data-story-id="{{item.id}}"
          bindtap="openStoryDetail"
        >
          <view class="story-title">{{item.title}}</view>
          <view class="story-summary">{{item.summary || item.content}}</view>
        </view>
      </view>
    </block>

    <block wx:else>
      <view class="panel empty-card">
        <view class="panel-title">{{emptyStateMessage}}</view>
        <view class="panel-text">快来分享你的所见所闻吧！</view>
        <view class="empty-actions">
          <button class="action-secondary action-primary" bindtap="handleShareStory">我来分享</button>
          <button class="action-secondary" bindtap="goBack">返回</button>
        </view>
      </view>
    </block>
  </block>
</view>
