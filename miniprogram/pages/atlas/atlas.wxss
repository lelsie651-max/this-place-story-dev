.summary-card {
  text-align: center;
  padding-top: 40rpx;
  padding-bottom: 36rpx;
  background: linear-gradient(180deg, rgba(255, 248, 236, 0.98), rgba(244, 228, 199, 0.92));
}

.summary-number {
  margin-bottom: 10rpx;
  font-size: 72rpx;
  font-weight: 600;
  color: #6b4527;
}

.summary-label {
  color: #8b5e34;
  font-size: 26rpx;
  line-height: 1.6;
}

.atlas-card {
  position: relative;
  background: linear-gradient(180deg, rgba(255, 251, 244, 0.98), rgba(249, 240, 226, 0.94));
}

.atlas-card::after {
  content: "›";
  position: absolute;
  top: 36rpx;
  right: 32rpx;
  color: rgba(139, 94, 52, 0.46);
  font-size: 34rpx;
}

.atlas-status-card {
  text-align: center;
  background: linear-gradient(180deg, rgba(255, 251, 244, 0.98), rgba(249, 240, 226, 0.94));
}

.atlas-status-title {
  margin-bottom: 14rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #4c3424;
}

.atlas-status-text {
  color: #8b5e34;
  font-size: 28rpx;
  line-height: 1.7;
}

.atlas-location {
  margin-bottom: 14rpx;
  padding-right: 44rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #4c3424;
  line-height: 1.45;
}

.atlas-type {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(140, 94, 52, 0.12);
  color: #8b5e34;
  font-size: 24rpx;
  line-height: 1.2;
}

.atlas-time {
  margin-top: 22rpx;
  color: #7a624c;
  font-size: 24rpx;
  line-height: 1.7;
}
