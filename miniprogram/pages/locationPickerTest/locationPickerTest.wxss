.page {
  min-height: 100vh;
  padding: 32rpx 24rpx 48rpx;
  background: #f6efe2;
  box-sizing: border-box;
}

.hero-card,
.panel {
  background: rgba(255, 252, 246, 0.95);
  border-radius: 28rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 12rpx 30rpx rgba(126, 86, 48, 0.08);
  border: 1rpx solid rgba(158, 111, 63, 0.12);
}

.hero-card {
  margin-bottom: 24rpx;
}

.hero-label {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: #9b7b59;
  margin-bottom: 12rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #5f442d;
  margin-bottom: 12rpx;
}

.hero-subtitle {
  font-size: 26rpx;
  line-height: 1.7;
  color: #7a624d;
}

.action-panel {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.action-button {
  width: 100%;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.action-button::after {
  border: none;
}

.action-button.primary {
  background: linear-gradient(135deg, #b57a41, #8f5e34);
  color: #fff9f2;
}

.action-button.secondary {
  background: #fff8ef;
  color: #7c5632;
  border: 1rpx solid rgba(143, 94, 52, 0.2);
}

.panel {
  margin-bottom: 24rpx;
}

.nested-panel {
  margin-top: 20rpx;
  margin-bottom: 0;
  background: #fcf6ed;
  box-shadow: none;
}

.status-panel {
  background: rgba(255, 250, 242, 0.98);
}

.warning-panel {
  background: #fff6ee;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #5f442d;
  margin-bottom: 20rpx;
}

.meta-row,
.field-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(158, 111, 63, 0.08);
}

.meta-row:last-child,
.field-row:last-child {
  border-bottom: none;
}

.meta-label,
.field-label {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #8c7157;
}

.meta-value,
.field-value {
  flex: 1;
  font-size: 26rpx;
  color: #5f442d;
  text-align: right;
  word-break: break-all;
}

.warning-text {
  margin-bottom: 16rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #9a5f2c;
}

.code-block {
  display: block;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #f2eadf;
  color: #4e3a28;
  font-size: 22rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-all;
}
