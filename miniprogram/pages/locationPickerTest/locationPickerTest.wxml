<view class="page">
  <view class="hero-card">
    <view class="hero-label">TEMP TEST PAGE</view>
    <view class="hero-title">微信原生地点选择验证</view>
    <view class="hero-subtitle">
      本页只用于验证微信原生地点选择能力，不调用 CloudBase，不请求腾讯 LBS，也不改现有探索链路。
    </view>
  </view>

  <view class="action-panel">
    <button class="action-button primary" bindtap="testChoosePoi" loading="{{loading}}" disabled="{{clickLocked}}">
      测试微信 POI 选择
    </button>
    <button class="action-button secondary" bindtap="testChooseLocation" loading="{{loading}}" disabled="{{clickLocked}}">
      测试微信地图选点
    </button>
  </view>

  <view class="panel status-panel">
    <view class="section-title">页面加载与接口状态</view>
    <view class="meta-row">
      <text class="meta-label">页面状态</text>
      <text class="meta-value">{{pageLoadMessage || '未加载'}}</text>
    </view>
    <view class="meta-row">
      <text class="meta-label">SDKVersion</text>
      <text class="meta-value">{{sdkVersion || '未知'}}</text>
    </view>
    <view class="meta-row">
      <text class="meta-label">canIUse choosePoi</text>
      <text class="meta-value">{{canIUseChoosePoi ? 'true' : 'false'}}</text>
    </view>
    <view class="meta-row">
      <text class="meta-label">canIUse chooseLocation</text>
      <text class="meta-value">{{canIUseChooseLocation ? 'true' : 'false'}}</text>
    </view>
    <view class="meta-row">
      <text class="meta-label">typeof wx.choosePoi</text>
      <text class="meta-value">{{choosePoiType || 'unknown'}}</text>
    </view>
    <view class="meta-row">
      <text class="meta-label">typeof wx.chooseLocation</text>
      <text class="meta-value">{{chooseLocationType || 'unknown'}}</text>
    </view>
    <view class="meta-row">
      <text class="meta-label">当前接口</text>
      <text class="meta-value">{{currentInterfaceName || '未开始测试'}}</text>
    </view>
    <view class="meta-row">
      <text class="meta-label">loading</text>
      <text class="meta-value">{{loading ? '是' : '否'}}</text>
    </view>
    <view class="meta-row">
      <text class="meta-label">点击锁</text>
      <text class="meta-value">{{clickLocked ? '已锁定' : '未锁定'}}</text>
    </view>
    <view class="meta-row">
      <text class="meta-label">当前动作</text>
      <text class="meta-value">{{lastActionMessage || '无'}}</text>
    </view>
    <view class="meta-row">
      <text class="meta-label">结果状态</text>
      <text class="meta-value">{{resultStatus || '未返回'}}</text>
    </view>
    <view class="meta-row">
      <text class="meta-label">complete 状态</text>
      <text class="meta-value">{{completeMessage || '未触发'}}</text>
    </view>
  </view>

  <view class="panel" wx:if="{{normalizedResult}}">
    <view class="section-title">整理后的字段</view>
    <view class="field-row">
      <text class="field-label">name</text>
      <text class="field-value">{{normalizedResult.name || '-'}}</text>
    </view>
    <view class="field-row">
      <text class="field-label">address</text>
      <text class="field-value">{{normalizedResult.address || '-'}}</text>
    </view>
    <view class="field-row">
      <text class="field-label">city</text>
      <text class="field-value">{{normalizedResult.city || '-'}}</text>
    </view>
    <view class="field-row">
      <text class="field-label">raw latitude</text>
      <text class="field-value">{{normalizedResult.rawLatitude || '-'}}</text>
    </view>
    <view class="field-row">
      <text class="field-label">raw longitude</text>
      <text class="field-value">{{normalizedResult.rawLongitude || '-'}}</text>
    </view>
    <view class="field-row">
      <text class="field-label">latitude</text>
      <text class="field-value">{{normalizedResult.latitudeDisplay || '未返回'}}</text>
    </view>
    <view class="field-row">
      <text class="field-label">longitude</text>
      <text class="field-value">{{normalizedResult.longitudeDisplay || '未返回'}}</text>
    </view>
    <view class="field-row">
      <text class="field-label">type</text>
      <text class="field-value">{{normalizedResult.type || '-'}}</text>
    </view>
    <view class="warning-text" wx:if="{{normalizedResult.coordinateMessage}}">
      {{normalizedResult.coordinateMessage}}
    </view>
  </view>

  <view class="panel" wx:if="{{rawSuccessResult}}">
    <view class="section-title">成功返回完整字段</view>
    <text class="code-block">{{rawSuccessResult}}</text>
  </view>

  <view class="panel" wx:if="{{rawCancelResult}}">
    <view class="section-title">取消信息</view>
    <text class="code-block">{{rawCancelResult}}</text>
  </view>

  <view class="panel warning-panel" wx:if="{{rawErrorResult}}">
    <view class="section-title">失败信息</view>
    <view class="warning-text">
      {{likelyPermissionIssue ? '可能与后台接口权限未开通有关。' : '当前错误未明显指向后台权限未开通，请结合 errMsg 继续核对。'}}
    </view>
    <view class="warning-text">
      {{likelyPrivacyConfigIssue ? '可能与 requiredPrivateInfos 或隐私声明未生效有关。' : '当前错误未明显指向隐私配置问题。'}}
    </view>
    <text class="code-block">{{rawErrorResult}}</text>
  </view>
</view>
