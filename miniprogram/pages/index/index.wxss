.page {
  position: relative;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at top, rgba(255, 248, 236, 0.92), rgba(239, 228, 210, 0.92) 48%, rgba(226, 207, 179, 0.96));
}

.home-main {
  flex: 0 0 auto;
}

.floating-profile {
  position: absolute;
  left: 32rpx;
  top: 12rpx;
  z-index: 30;
  width: 88rpx;
  height: 88rpx;
  background: transparent;
}

.floating-profile-hover {
  opacity: 0.82;
}

.avatar-circle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(140, 94, 52, 0.22);
  border-radius: 24rpx;
  background: linear-gradient(180deg, rgba(255, 248, 236, 0.98), rgba(233, 211, 176, 0.96));
  color: #5b3922;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 16rpx 34rpx rgba(107, 69, 39, 0.16);
}

.hero {
  margin-bottom: 48rpx;
  padding-top: 152rpx;
  text-align: center;
}

.hero-title {
  margin-bottom: 14rpx;
  font-size: 72rpx;
  font-weight: 600;
  line-height: 1.2;
  color: #412a1f;
  text-align: center;
}

.hero-english {
  display: block;
  margin-bottom: 12rpx;
  color: rgba(139, 94, 52, 0.58);
  font-size: 20rpx;
  font-weight: 400;
  line-height: 1.2;
  letter-spacing: 6rpx;
  text-align: center;
}

.hero-slogan {
  margin: 0 auto;
  color: #5b3922;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.5;
  text-align: center;
}

.primary-entry {
  text-align: center;
  padding-top: 48rpx;
  padding-bottom: 40rpx;
  transform: none;
}

.entry-icon {
  margin-bottom: 20rpx;
  font-size: 84rpx;
  background: none;
  box-shadow: none;
  transform: none;
}

.company-footer {
  margin-top: auto;
  padding-top: 32rpx;
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
  color: rgba(62, 82, 76, 0.48);
}
