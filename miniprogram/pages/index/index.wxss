.page {
  position: relative;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at top, rgba(255, 248, 236, 0.92), rgba(239, 228, 210, 0.92) 48%, rgba(226, 207, 179, 0.96));
}

.home-main {
  flex: 0 0 auto;
}

.floating-profile {
  position: absolute;
  left: 32rpx;
  top: 12rpx;
  z-index: 30;
  width: 88rpx;
  height: 88rpx;
  background: transparent;
}

.floating-profile-hover {
  opacity: 0.82;
}

.avatar-circle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(140, 94, 52, 0.22);
  border-radius: 24rpx;
  background: linear-gradient(180deg, rgba(255, 248, 236, 0.98), rgba(233, 211, 176, 0.96));
  color: #5b3922;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 16rpx 34rpx rgba(107, 69, 39, 0.16);
}

.hero {
  margin-bottom: 48rpx;
  padding-top: 152rpx;
  text-align: center;
}

.hero-title {
  margin-bottom: 14rpx;
  font-size: 72rpx;
  font-weight: 600;
  line-height: 1.2;
  color: #412a1f;
  text-align: center;
}

.hero-english {
  display: block;
  margin-bottom: 12rpx;
  color: rgba(139, 94, 52, 0.58);
  font-size: 20rpx;
  font-weight: 400;
  line-height: 1.2;
  letter-spacing: 6rpx;
  text-align: center;
}

.hero-slogan {
  margin: 0 auto;
  color: #5b3922;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.5;
  text-align: center;
}

.primary-entry {
  text-align: center;
  padding-top: 48rpx;
  padding-bottom: 40rpx;
  transform: none;
}

.recommendation-section {
  margin-top: 32rpx;
  padding: 40rpx 32rpx 36rpx;
}

.recommendation-label {
  margin-bottom: 12rpx;
}

.recommendation-title {
  margin-bottom: 28rpx;
  color: #5b3922;
  font-size: 28rpx;
  line-height: 1.6;
}

.recommendation-swiper-wrap {
  overflow: hidden;
}

.recommendation-swiper {
  width: 100%;
  height: 356rpx;
}

.recommendation-slide {
  display: flex;
  justify-content: center;
  align-items: stretch;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
}

.recommendation-card {
  display: flex;
  align-items: stretch;
  width: 100%;
  height: 300rpx;
  box-sizing: border-box;
  overflow: hidden;
  border: 1rpx solid rgba(140, 94, 52, 0.12);
  border-radius: 28rpx;
  background: linear-gradient(180deg, rgba(255, 250, 242, 0.98), rgba(248, 238, 220, 0.98));
  box-shadow: 0 20rpx 36rpx rgba(107, 69, 39, 0.12);
}

.recommendation-card-hover {
  opacity: 0.9;
}

.recommendation-cover {
  flex: 0 0 214rpx;
  width: 214rpx;
  background: linear-gradient(180deg, rgba(226, 207, 179, 0.95), rgba(212, 184, 149, 0.92));
}

.recommendation-cover-image {
  width: 100%;
  height: 100%;
}

.recommendation-cover-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  color: rgba(65, 42, 31, 0.84);
}

.recommendation-cover-emoji {
  margin-bottom: 16rpx;
  font-size: 54rpx;
}

.recommendation-cover-text {
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.recommendation-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
  padding: 28rpx 28rpx 24rpx;
  box-sizing: border-box;
}

.recommendation-card-label {
  align-self: flex-start;
}

.recommendation-card-title {
  margin-top: 14rpx;
  color: #412a1f;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recommendation-card-location {
  margin-top: 10rpx;
  color: rgba(91, 57, 34, 0.72);
  font-size: 24rpx;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recommendation-card-summary {
  margin-top: 14rpx;
  color: rgba(65, 42, 31, 0.86);
  font-size: 24rpx;
  line-height: 1.7;
  display: -webkit-box;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.recommendation-card-action {
  margin-top: 20rpx;
  color: #8b5e34;
  font-size: 24rpx;
  font-weight: 600;
}

.recommendation-loading,
.recommendation-empty {
  border-radius: 28rpx;
  background: rgba(255, 250, 242, 0.72);
}

.recommendation-loading {
  padding: 24rpx;
}

.recommendation-skeleton-card {
  display: flex;
  align-items: stretch;
  min-height: 248rpx;
  border-radius: 24rpx;
  background: rgba(255, 248, 236, 0.96);
}

.recommendation-skeleton-cover {
  flex: 0 0 214rpx;
  border-radius: 24rpx 0 0 24rpx;
  background: rgba(226, 207, 179, 0.45);
}

.recommendation-skeleton-content {
  flex: 1;
  padding: 28rpx;
}

.recommendation-skeleton-line {
  height: 24rpx;
  margin-bottom: 20rpx;
  border-radius: 999rpx;
  background: rgba(140, 94, 52, 0.14);
}

.recommendation-skeleton-line--short {
  width: 40%;
}

.recommendation-empty {
  padding: 44rpx 24rpx;
}

.recommendation-empty-text {
  color: rgba(91, 57, 34, 0.72);
  font-size: 24rpx;
  line-height: 1.7;
  text-align: center;
}

.entry-icon {
  margin-bottom: 20rpx;
  font-size: 84rpx;
  background: none;
  box-shadow: none;
  transform: none;
}

.company-footer {
  margin-top: auto;
  padding-top: 32rpx;
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
  color: rgba(62, 82, 76, 0.48);
}
