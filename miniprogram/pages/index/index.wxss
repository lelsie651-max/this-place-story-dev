.top-bar {
  display: flex;
  align-items: flex-start;
  justify-content: flex-start;
  margin-bottom: 28rpx;
  box-sizing: border-box;
}

.avatar-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 14rpx;
  min-width: 132rpx;
  min-height: 132rpx;
  border: 1rpx solid rgba(140, 94, 52, 0.14);
  border-radius: 999rpx;
  background: rgba(255, 248, 236, 0.82);
  line-height: 1;
  box-shadow: 0 14rpx 28rpx rgba(107, 69, 39, 0.12);
}

.avatar-button::after {
  border: none;
}

.avatar-circle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  border: 1rpx solid rgba(140, 94, 52, 0.22);
  border-radius: 28rpx;
  background: linear-gradient(180deg, rgba(255, 248, 236, 0.98), rgba(233, 211, 176, 0.96));
  color: #5b3922;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 16rpx 34rpx rgba(107, 69, 39, 0.16);
}

.hero {
  margin-bottom: 48rpx;
  padding-top: 16rpx;
  text-align: center;
}

.hero-title {
  margin-bottom: 14rpx;
  font-size: 72rpx;
  font-weight: 600;
  line-height: 1.2;
  color: #412a1f;
}

.hero-subtitle {
  margin-bottom: 20rpx;
  color: #8b5e34;
  font-size: 32rpx;
}

.hero-copy {
  max-width: 620rpx;
  margin: 0 auto;
  color: #6f5740;
  line-height: 1.8;
}

.primary-entry {
  text-align: center;
  padding-top: 48rpx;
  padding-bottom: 40rpx;
}

.entry-icon {
  margin-bottom: 20rpx;
  font-size: 84rpx;
}
