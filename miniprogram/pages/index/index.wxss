/* =====================================================
   首页显示/隐藏控制区
   显示：display: block / inline
   隐藏：display: none
   只改 display 后面的值，不要改 selector 和花括号。
   ===================================================== */

.page.page--embedded-branding .hero-title {
  display: none; /* 首页中文标题：背景图已有 logo 时默认隐藏；恢复显示改 block */
}

.page.page--embedded-branding .hero-english {
  display: none; /* 首页英文副标题：背景图已有文字时默认隐藏；恢复显示改 block */
}

.page.page--embedded-branding .hero-slogan,
.page.page--embedded-branding .hero-subtitle,
.page.page--embedded-branding .hero-copy {
  display: none; /* 首页宣传语：背景图已有文案时默认隐藏；恢复显示改 block */
}

.page.page--embedded-branding .home-background-image {
  top: 0rpx; /* 背景图上下位置：正数向下，负数向上 */
  left: 0rpx; /* 背景图左右位置：正数向右，负数向左 */
  width: 100%; /* 背景图宽度：改大可放大显示区域 */
  height: 100vh; /* 背景图高度：通常保持 100vh */
  transform: translateX(0rpx) translateY(0rpx) scale(1); /* 0rpx=不左右移动，0rpx=不上下移动，1=原始缩放 */
  transform-origin: center top;
}

.page.page--embedded-branding .hero {
  padding-top: 420rpx; /* 嵌入品牌模式下，按钮距离顶部背景 Logo 的起始高度 */
  margin-bottom: 24rpx; /* hero 与下方“寻找传说”区域的间距 */
}

.page.page--embedded-branding .primary-button-image {
  display: block; /* 按钮背景图显示开关：隐藏改 none，恢复改 block */
}

.page.page--embedded-branding .primary-entry-icon,
.page.page--embedded-branding .primary-button-icon {
  display: none; /* 放大镜 icon 显示开关：隐藏改 none，恢复改 block */
}

.page.page--embedded-branding .primary-button-label {
  display: none; /* “寻找传说”文字显示开关：隐藏改 none，恢复改 inline */
}

.page.page--embedded-branding .recommendation-heading {
  display: none; /* “编辑推荐”标题显示开关：隐藏改 none，恢复改 block */
}

.page.page--embedded-branding .recommendation-subtitle {
  display: none; /* 推荐副标题显示开关：隐藏改 none，恢复改 block */
}

.page.page--embedded-branding .recommendation-cover-placeholder-icon {
  display: none; /* “传说节选”图标显示开关：隐藏改 none，恢复改 block */
}

.page.page--embedded-branding .recommendation-cover-placeholder-label {
  display: none; /* “传说节选”文字显示开关：隐藏改 none，恢复改 block */
}

.page.page--embedded-branding .recommendation-card-title,
.page.page--embedded-branding .recommendation-card-location,
.page.page--embedded-branding .recommendation-card-summary,
.page.page--embedded-branding .recommendation-card-action {
  display: block; /* 推荐卡片文字显示开关：隐藏改 none，恢复改 block */
}

/* =====================================================
   首页品牌图布局调整区
   用户只需要修改这里已经标注的数字。
   不要修改 selector、花括号、事件和页面逻辑。
   单位使用 rpx。
   说明：
   1. rpx 是响应式尺寸单位，改大就更大，改小就更小。
   2. translateX 正数向右，负数向左。
   3. translateY 正数向下，负数向上。
   4. 改 width / min-height / height 会改变板块大小。
   5. 改 transform 只移动板块位置。
   6. 改 margin 会改变板块之间的间距。
   7. 去掉 .page--embedded-branding 后，可恢复普通文字模式。
   ===================================================== */

.page.page--embedded-branding {
  position: relative;
  width: 100%;
  height: 100vh;
  min-height: 100vh;
  max-height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
  padding: 0;
}

.page.page--embedded-branding .home-main {
  position: relative;
  width: 100%;
  height: 100%;
  min-height: 0;
  overflow: visible;
}

.page.page--embedded-branding .home-primary-entry-panel-image {
  display: none; /* 隐藏外框图时改成 none；恢复显示时改回 block */
  width: 686rpx; /* 寻找传说外框图片宽度 */
  height: 250rpx; /* 寻找传说外框图片高度 */
  top: 0rpx; /* 寻找传说外框图片上下位置：正数向下，负数向上 */
  left: 0rpx; /* 寻找传说外框图片左右位置：正数向右，负数向左 */
  transform: translateX(0rpx) translateY(0rpx); /* 外框图片左右/上下移动 */
  transform-origin: center top; /* 外框图片缩放基准点 */
}

.page.page--embedded-branding .home-primary-entry-content {
  width: 686rpx; /* 寻找传说内容层宽度 */
  margin-top: 0rpx; /* 寻找传说内容层与上方的间距 */
  margin-left: 0rpx; /* 寻找传说内容层左右偏移 */
  transform: translateX(0rpx) translateY(0rpx); /* 寻找传说内容层左右/上下移动 */
  padding: 42rpx 32rpx 38rpx; /* 寻找传说内容层内边距 */
}

.page.page--embedded-branding .primary-entry .action-button--image {
  width: 500rpx; /* 寻找传说按钮宽度 */
  min-height: 150rpx; /* 寻找传说按钮高度 */
  transform: translateX(-10rpx) translateY(-90rpx); /* 按钮左右/上下移动 */
  margin: 16rpx auto 0; /* 按钮与上方放大镜的间距 */
}

.page.page--embedded-branding .recommendation-panel-image {
  display: none; /* 隐藏外框图时改成 none；恢复显示时改回 block */
  width: 686rpx; /* 编辑推荐外框图片宽度 */
  height: 448rpx; /* 编辑推荐外框图片高度 */
  top: -200rpx; /* 编辑推荐外框图片上下位置：正数向下，负数向上 */
  left: 0rpx; /* 编辑推荐外框图片左右位置：正数向右，负数向左 */
  transform: translateX(0rpx) translateY(0rpx); /* 编辑推荐外框图片左右/上下移动 */
}

.page.page--embedded-branding .recommendation-panel-content {
  width: 686rpx; /* 编辑推荐内容层宽度 */
  margin-top: 32rpx; /* 编辑推荐内容层与寻找传说区域的间距 */
  margin-left: 0rpx; /* 编辑推荐内容层左右偏移 */
  transform: translateX(-30rpx) translateY(-95rpx); /* 编辑推荐内容层左右/上下移动 */
  padding: 38rpx 30rpx 34rpx; /* 编辑推荐内容层内边距 */
}

.page.page--embedded-branding .home-recommendation-slot {
  position: absolute;
  left: 0rpx;
  top: 0rpx;
  width: 100%;
  height: 0rpx;
  margin: 0;
  overflow: visible;
}

.page.page--embedded-branding .recommendation-panel-content {
  position: absolute;
  left: 0rpx;
  top: 0rpx;
  width: 100%;
  height: 0rpx;
  margin: 0;
  padding: 0;
  transform: none;
  overflow: visible;
}

.page.page--embedded-branding .home-recommendation-content {
  position: absolute;
  left: 0rpx;
  top: 0rpx;
  width: 100%;
  height: 0rpx;
  overflow: visible;
}

.home-recommendation-native {
  display: block;
}

.home-recommendation-design-canvas {
  display: none;
}

.page.page--embedded-branding .home-recommendation-native {
  display: none;
}

.page.page--embedded-branding .home-recommendation-design-canvas {
  display: block;
  position: absolute;
  left: 0rpx; /* 设计画布左右位置 */
  top: 0rpx; /* 设计画布上下位置 */
  width: 750rpx; /* 设计画布宽度 */
  height: 900rpx; /* 设计画布工作高度，不作为页面滚动高度 */
  overflow: visible;
}

.page.page--embedded-branding .home-recommendation-panel {
  display: block;
  position: absolute;
  left: 0rpx; /* 编辑推荐外框左右位置 */
  top: 0rpx; /* 编辑推荐外框上下位置 */
  width: 686rpx; /* 编辑推荐外框宽度 */
  height: 448rpx; /* 编辑推荐外框高度 */
  overflow: visible;
}

.page.page--embedded-branding .home-recommendation-panel-image {
  display: block; /* 外层面板图片显示开关 */
  position: absolute;
  left: 0rpx;
  top: 0rpx;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.page.page--embedded-branding .home-recommendation-card {
  display: flex;
  position: absolute;
  left: 0rpx; /* 内部传说节选卡片左右位置 */
  top: 0rpx; /* 内部传说节选卡片上下位置 */
  width: 624rpx; /* 内部传说节选卡片宽度 */
  height: 312rpx; /* 内部传说节选卡片高度 */
  overflow: hidden;
  box-sizing: border-box;
  transform: translateX(0rpx) translateY(0rpx); /* 卡片移动，不改变点击逻辑 */
  margin: 0;
}

.page.page--embedded-branding .home-recommendation-card .recommendation-card-content {
  display: flex;
  position: relative;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.page.page--embedded-branding .recommendation-cover {
  width: 220rpx; /* 左侧封面宽度 */
  height: 312rpx; /* 左侧封面高度 */
  flex: 0 0 220rpx; /* flex-basis 必须和 width 同步 */
  min-width: 0;
  min-height: 0;
  flex-shrink: 0;
  box-sizing: border-box;
}

.page.page--embedded-branding .recommendation-cover-image,
.page.page--embedded-branding .recommendation-cover-visual-image,
.page.page--embedded-branding .recommendation-cover-placeholder {
  display: block;
  width: 100%;
  height: 100%;
}

.page.page--embedded-branding .home-recommendation-card .recommendation-body {
  flex: 1 1 auto;
  width: auto;
  min-width: 0;
  padding: 28rpx 28rpx 26rpx;
  box-sizing: border-box;
  transform: none;
  margin: 0;
}

.page.page--embedded-branding .home-recommendation-card .recommendation-card-title,
.page.page--embedded-branding .home-recommendation-card .recommendation-card-location,
.page.page--embedded-branding .home-recommendation-card .recommendation-card-summary,
.page.page--embedded-branding .home-recommendation-card .recommendation-card-action {
  display: block;
}

.page.page--embedded-branding .recommendation-card-title {
  margin-top: 14rpx; /* 标题与上方标签的间距 */
  transform: translateY(0rpx); /* 标题上下位置 */
}

.page.page--embedded-branding .recommendation-card-location {
  margin-top: 10rpx; /* 地点与标题的间距 */
  transform: translateY(0rpx); /* 地点上下位置 */
}

.page.page--embedded-branding .recommendation-card-summary {
  margin-top: 14rpx; /* 简介与地点的间距 */
  transform: translateY(0rpx); /* 简介上下位置 */
}

.page.page--embedded-branding .recommendation-card-action {
  padding-top: 22rpx; /* “免费阅读”与简介的间距 */
  transform: translateY(0rpx); /* “免费阅读”上下位置 */
}

