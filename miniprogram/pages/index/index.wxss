/* =====================================================
   首页布局调整区
   用户只需要修改这里已经标注的数字。
   不要修改 selector、花括号、事件和页面逻辑。
   单位使用 rpx。
   说明：
   1. rpx 是响应式尺寸单位，改大就更大，改小就更小。
   2. translateX 正数向右，负数向左。
   3. translateY 正数向下，负数向上。
   4. 改 width / min-height / height 会改变板块大小。
   5. 改 transform 只移动板块位置。
   6. 改 margin 会改变板块之间的间距。
   7. 去掉 .page--embedded-branding 后，可恢复普通文字模式。
   ===================================================== */

.page.page--embedded-branding .home-background-image {
  top: 0rpx; /* 背景图上下位置：正数向下，负数向上 */
  left: 0rpx; /* 背景图左右位置：正数向右，负数向左 */
  width: 100%; /* 背景图宽度：改大可放大显示区域 */
  height: 100vh; /* 背景图高度：通常保持 100vh */
  transform: translateX(0rpx) translateY(0rpx) scale(1); /* 0rpx=不左右移动，0rpx=不上下移动，1=原始缩放 */
  transform-origin: center top;
}

.page.page--embedded-branding .hero {
  padding-top: 420rpx; /* 嵌入品牌模式下，按钮距离顶部背景 Logo 的起始高度 */
  margin-bottom: 24rpx; /* hero 与下方“寻找传说”区域的间距 */
}

.page.page--embedded-branding .home-primary-entry-slot {
  width: 686rpx; /* “寻找传说”外层区域宽度 */
  min-height: 250rpx; /* “寻找传说”外层区域最小高度 */
  margin-top: 0rpx; /* “寻找传说”外层区域与上方的间距 */
  margin-bottom: 0rpx; /* “寻找传说”外层区域与下方的间距 */
  transform: translateX(0rpx) translateY(0rpx); /* 外层区域左右/上下移动 */
}

.page.page--embedded-branding .primary-entry {
  width: 686rpx; /* 外层卡片宽度 */
  min-height: 250rpx; /* 外层卡片最小高度 */
  margin-top: 0rpx; /* 外层卡片内部顶部偏移 */
  margin-bottom: 0rpx; /* 外层卡片内部底部偏移 */
}

.page.page--embedded-branding .primary-entry .actions {
  margin-top: 16rpx; /* 按钮与上方图标的间距 */
}

.page.page--embedded-branding .primary-entry .action-button--image {
  width: 620rpx; /* 寻找传说按钮宽度 */
  min-height: 96rpx; /* 寻找传说按钮高度 */
  transform: translateX(0rpx) translateY(0rpx); /* 按钮左右/上下移动 */
}

.page.page--embedded-branding .home-recommendation-slot {
  width: 686rpx; /* 编辑推荐外层区域宽度 */
  min-height: 448rpx; /* 编辑推荐外层区域最小高度 */
  margin-top: 32rpx; /* 编辑推荐与“寻找传说”区域的间距 */
  margin-bottom: 0rpx; /* 编辑推荐与下方页脚的间距 */
  transform: translateX(0rpx) translateY(0rpx); /* 编辑推荐外层左右/上下移动 */
}

.page.page--embedded-branding .recommendation-section {
  width: 686rpx; /* 编辑推荐外框宽度 */
  min-height: 448rpx; /* 编辑推荐外框最小高度 */
  margin-top: 0rpx; /* 编辑推荐外框顶部偏移 */
  margin-bottom: 0rpx; /* 编辑推荐外框底部偏移 */
}

.page.page--embedded-branding .recommendation-card {
  width: 624rpx; /* 推荐内部卡片宽度 */
  height: 312rpx; /* 推荐内部卡片高度 */
  transform: translateX(0rpx) translateY(0rpx); /* 推荐内部卡片左右/上下移动 */
}

.page.page--embedded-branding .recommendation-cover {
  width: 220rpx; /* 左侧封面宽度 */
  flex: 0 0 220rpx; /* 左侧封面宽度，通常与上一行保持一致 */
}

.page.page--embedded-branding .recommendation-body {
  flex: none;
  width: calc(100% - 220rpx); /* 文字区域宽度：通常等于卡片宽度减去左侧封面宽度 */
}

.page.page--embedded-branding .recommendation-card-title {
  margin-top: 14rpx; /* 标题与上方标签的间距 */
  transform: translateY(0rpx); /* 标题上下位置 */
}

.page.page--embedded-branding .recommendation-card-location {
  margin-top: 10rpx; /* 地点与标题的间距 */
  transform: translateY(0rpx); /* 地点上下位置 */
}

.page.page--embedded-branding .recommendation-card-summary {
  margin-top: 14rpx; /* 简介与地点的间距 */
  transform: translateY(0rpx); /* 简介上下位置 */
}

.page.page--embedded-branding .recommendation-card-action {
  padding-top: 22rpx; /* “免费阅读”与简介的间距 */
  transform: translateY(0rpx); /* “免费阅读”上下位置 */
}

.page {
  position: relative;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(112rpx + env(safe-area-inset-bottom));
  background: #efe4d2;
}

.home-background-layer {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  z-index: 0;
  pointer-events: none;
}

.home-background-image {
  position: absolute;
  top: 0rpx;
  left: 0rpx;
  width: 100%;
  height: 100vh;
  pointer-events: none;
}

.home-main {
  flex: 0 0 auto;
  position: relative;
  z-index: 1;
}

.home-primary-entry-slot,
.home-recommendation-slot {
  position: relative;
  z-index: 1;
  margin-left: auto;
  margin-right: auto;
}

.hero {
  margin-bottom: 52rpx;
  padding-top: 72rpx;
  text-align: center;
}

.hero-title {
  margin-bottom: 16rpx;
  font-size: 72rpx;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: 2rpx;
  color: #412a1f;
  text-align: center;
}

.hero-english {
  display: block;
  margin-bottom: 14rpx;
  color: rgba(139, 94, 52, 0.58);
  font-size: 18rpx;
  font-weight: 400;
  line-height: 1.2;
  letter-spacing: 6rpx;
  text-align: center;
}

.hero-slogan {
  margin: 0 auto;
  color: #5b3922;
  max-width: 520rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.7;
  text-align: center;
}

.page--embedded-branding .hero-title,
.page--embedded-branding .hero-english,
.page--embedded-branding .hero-slogan {
  display: none;
}

.panel-visual-image,
.recommendation-card-visual-image,
.recommendation-cover-visual-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

.panel-visual-content,
.recommendation-card-content {
  position: relative;
  z-index: 1;
}

.primary-entry {
  position: relative;
  width: 100%;
  box-sizing: border-box;
  text-align: center;
  padding-top: 42rpx;
  padding-bottom: 38rpx;
  transform: none;
  background: transparent;
}

.primary-entry .actions {
  align-items: center;
}

.primary-entry .action-button--image {
  position: relative;
  overflow: hidden;
  background: transparent;
  border: none;
}

.primary-entry .action-button--image::after {
  border: none;
}

.action-button-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: inherit;
  pointer-events: none;
}

.action-button-label {
  position: relative;
  z-index: 1;
}

.recommendation-section {
  position: relative;
  width: 100%;
  padding: 38rpx 30rpx 34rpx;
  background: transparent;
}

.recommendation-label {
  margin-bottom: 12rpx;
}

.recommendation-title {
  margin-bottom: 28rpx;
  color: #5b3922;
  font-size: 26rpx;
  line-height: 1.7;
}

.recommendation-swiper-wrap {
  overflow: hidden;
}

.recommendation-swiper {
  width: 100%;
  height: 372rpx;
}

.recommendation-slide {
  display: flex;
  justify-content: center;
  align-items: stretch;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
}

.recommendation-card {
  display: flex;
  align-items: stretch;
  width: 100%;
  height: 312rpx;
  position: relative;
  box-sizing: border-box;
  overflow: hidden;
  border: 1rpx solid rgba(140, 94, 52, 0.12);
  border-radius: 28rpx;
  background: transparent;
  box-shadow: 0 22rpx 40rpx rgba(107, 69, 39, 0.12);
}

.recommendation-card-hover {
  opacity: 0.9;
}

.recommendation-card-content {
  display: flex;
  align-items: stretch;
  width: 100%;
  height: 100%;
}

.recommendation-cover {
  position: relative;
  flex: 0 0 220rpx;
  width: 220rpx;
  overflow: hidden;
  background: transparent;
}

.recommendation-cover-image {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
}

.recommendation-cover-placeholder {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  color: rgba(65, 42, 31, 0.84);
}

.recommendation-cover-emoji {
  margin-bottom: 16rpx;
  font-size: 54rpx;
}

.recommendation-cover-text {
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.recommendation-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  min-width: 0;
  padding: 28rpx 28rpx 26rpx;
  box-sizing: border-box;
}

.recommendation-card-label {
  align-self: flex-start;
}

.recommendation-card-title {
  margin-top: 14rpx;
  color: #412a1f;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recommendation-card-location {
  margin-top: 10rpx;
  color: rgba(91, 57, 34, 0.72);
  font-size: 24rpx;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recommendation-card-summary {
  margin-top: 14rpx;
  color: rgba(65, 42, 31, 0.86);
  font-size: 24rpx;
  line-height: 1.7;
  display: -webkit-box;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.recommendation-card-action {
  margin-top: auto;
  padding-top: 22rpx;
  color: #8b5e34;
  font-size: 24rpx;
  font-weight: 600;
}

.recommendation-loading,
.recommendation-empty {
  border-radius: 28rpx;
  background: rgba(255, 250, 242, 0.72);
}

.recommendation-loading {
  padding: 24rpx;
}

.recommendation-skeleton-card {
  display: flex;
  align-items: stretch;
  min-height: 260rpx;
  border-radius: 24rpx;
  background: rgba(255, 248, 236, 0.96);
}

.recommendation-skeleton-cover {
  flex: 0 0 220rpx;
  border-radius: 24rpx 0 0 24rpx;
  background: rgba(226, 207, 179, 0.45);
}

.recommendation-skeleton-content {
  flex: 1;
  padding: 28rpx;
}

.recommendation-skeleton-line {
  height: 24rpx;
  margin-bottom: 20rpx;
  border-radius: 999rpx;
  background: rgba(140, 94, 52, 0.14);
}

.recommendation-skeleton-line--short {
  width: 40%;
}

.recommendation-empty {
  padding: 44rpx 24rpx;
}

.recommendation-empty-text {
  color: rgba(91, 57, 34, 0.72);
  font-size: 24rpx;
  line-height: 1.7;
  text-align: center;
}

.entry-icon {
  margin-bottom: 16rpx;
  font-size: 76rpx;
  background: none;
  box-shadow: none;
  transform: none;
}

.company-footer {
  margin-top: auto;
  padding-top: 32rpx;
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
  color: rgba(91, 57, 34, 0.42);
  position: relative;
  z-index: 1;
}
