.page {
  position: relative;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding-bottom: calc(88rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at top left, rgba(250, 247, 236, 0.96), rgba(242, 245, 235, 0.92) 36%, rgba(228, 237, 228, 0.94) 100%),
    linear-gradient(180deg, #f7f4ea 0%, #edf3ea 44%, #e4ece6 100%);
}

.home-main {
  flex: 1;
}

.floating-profile {
  position: absolute;
  left: 32rpx;
  top: 12rpx;
  z-index: 30;
  width: 88rpx;
  height: 88rpx;
  background: transparent;
}

.floating-profile-hover {
  opacity: 0.82;
}

.avatar-circle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border: 1rpx solid rgba(78, 104, 91, 0.24);
  border-radius: 24rpx;
  background: linear-gradient(180deg, rgba(252, 249, 239, 0.98), rgba(227, 237, 219, 0.96));
  color: #25433c;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 16rpx 34rpx rgba(59, 87, 76, 0.14);
}

.hero {
  margin-bottom: 54rpx;
  padding-top: 152rpx;
  text-align: center;
}

.hero-title {
  margin-bottom: 14rpx;
  font-size: 72rpx;
  font-weight: 600;
  line-height: 1.18;
  color: #24403a;
  letter-spacing: 2rpx;
}

.hero-english {
  margin-bottom: 20rpx;
  color: rgba(63, 94, 88, 0.58);
  font-size: 20rpx;
  letter-spacing: 8rpx;
}

.hero-slogan {
  max-width: 560rpx;
  margin: 0 auto;
  color: #35524c;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.55;
}

.primary-entry {
  position: relative;
  overflow: hidden;
  text-align: center;
  padding: 54rpx 34rpx 40rpx;
  border-radius: 34rpx 30rpx 38rpx 28rpx;
  border: 1rpx solid rgba(94, 127, 114, 0.14);
  background:
    linear-gradient(180deg, rgba(255, 252, 244, 0.96), rgba(246, 250, 242, 0.94)),
    rgba(255, 252, 244, 0.96);
  box-shadow:
    0 18rpx 42rpx rgba(75, 99, 89, 0.10),
    inset 0 0 0 2rpx rgba(255, 255, 255, 0.28);
  transform: rotate(-1deg);
}

.sticker {
  position: absolute;
  z-index: 1;
}

.sticker-tape {
  top: 26rpx;
  left: 38rpx;
  width: 112rpx;
  height: 24rpx;
  border-radius: 8rpx;
  background: rgba(244, 218, 140, 0.48);
  transform: rotate(-12deg);
}

.sticker-corner {
  top: 26rpx;
  right: 30rpx;
  color: #ef8b61;
  font-size: 30rpx;
  transform: rotate(12deg);
}

.travel-route {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 22rpx;
  position: relative;
  z-index: 2;
}

.route-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.route-dot-start {
  background: #d6c15d;
}

.route-dot-end {
  background: #6f95a3;
}

.route-line {
  width: 138rpx;
  margin: 0 12rpx;
  border-top: 3rpx dashed rgba(98, 131, 119, 0.44);
}

.entry-icon {
  position: relative;
  z-index: 2;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 126rpx;
  height: 126rpx;
  margin-bottom: 18rpx;
  border-radius: 32rpx;
  background: linear-gradient(180deg, rgba(255, 245, 207, 0.96), rgba(255, 234, 184, 0.92));
  box-shadow: 0 14rpx 28rpx rgba(165, 130, 62, 0.14);
  font-size: 80rpx;
  transform: rotate(4deg);
}

.entry-badge {
  position: relative;
  z-index: 2;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 22rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(124, 157, 146, 0.14);
  color: #4e6d66;
  font-size: 24rpx;
  letter-spacing: 4rpx;
}

.entry-compass {
  position: absolute;
  right: 42rpx;
  bottom: 174rpx;
  z-index: 1;
  color: rgba(111, 149, 163, 0.62);
  font-size: 52rpx;
  transform: rotate(12deg);
}

.actions {
  position: relative;
  z-index: 2;
  gap: 20rpx;
  margin-top: 10rpx;
}

.action-button {
  background: linear-gradient(135deg, #7ea25d, #62835e);
  color: #fffdf6;
  box-shadow: 0 14rpx 30rpx rgba(86, 123, 95, 0.18);
}

.action-button.secondary {
  background: rgba(238, 246, 248, 0.95);
  border: 1rpx solid rgba(111, 149, 163, 0.30);
  color: #46626c;
}

.company-footer {
  margin-top: 24rpx;
  padding-top: 8rpx;
  color: rgba(62, 82, 76, 0.48);
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
}
