.page {
  position: relative;
}

.floating-profile {
  position: absolute;
  left: 32rpx;
  top: 12rpx;
  z-index: 30;
  width: 88rpx;
  height: 88rpx;
  background: transparent;
}

.floating-profile-hover {
  opacity: 0.82;
}

.avatar-circle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border: 1rpx solid rgba(140, 94, 52, 0.22);
  border-radius: 24rpx;
  background: linear-gradient(180deg, rgba(255, 248, 236, 0.98), rgba(233, 211, 176, 0.96));
  color: #5b3922;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 16rpx 34rpx rgba(107, 69, 39, 0.16);
}

.hero {
  margin-bottom: 48rpx;
  padding-top: 152rpx;
  text-align: center;
}

.hero-title {
  margin-bottom: 14rpx;
  font-size: 72rpx;
  font-weight: 600;
  line-height: 1.2;
  color: #412a1f;
}

.hero-subtitle {
  margin-bottom: 20rpx;
  color: #8b5e34;
  font-size: 32rpx;
}

.hero-copy {
  max-width: 620rpx;
  margin: 0 auto;
  color: #6f5740;
  line-height: 1.8;
}

.primary-entry {
  text-align: center;
  padding-top: 48rpx;
  padding-bottom: 40rpx;
}

.entry-icon {
  margin-bottom: 20rpx;
  font-size: 84rpx;
}
