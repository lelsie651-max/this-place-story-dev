<view class="page page--embedded-branding">
  <view class="home-background-layer">
    <image
      class="home-background-image"
      src="../../assets/backgrounds/home-background-placeholder.png"
      mode="aspectFill"
    />
  </view>
  <view class="home-main">
    <view class="hero">
      <view class="hero-title" data-design-id="index-page-title">此地有传说</view>
      <view class="section-label hero-english">THIS PLACE HAS LEGENDS</view>
      <view class="hero-slogan hero-subtitle hero-copy" data-design-id="index-page-subtitle">让地点拥有不同的声音</view>
    </view>

    <view class="home-primary-entry-slot">
      <image
        class="home-primary-entry-panel-image primary-entry-panel-image"
        src="../../assets/cards/home-primary-entry-panel-placeholder.png"
        mode="scaleToFill"
      />
      <view class="home-primary-entry-content primary-entry panel">
        <view class="entry-icon primary-entry-icon primary-button-icon">🔍</view>
        <view class="actions">
          <button class="action-button action-button--image" bindtap="goToExplore" data-design-id="index-primary-button">
            <image
              class="action-button-image primary-button-image"
              src="../../assets/buttons/home-primary-button-placeholder.png"
              mode="scaleToFill"
            />
            <text class="action-button-label primary-button-label">寻找传说</text>
          </button>
        </view>
      </view>
    </view>

    <view class="home-recommendation-slot">
      <image
        class="recommendation-panel-image"
        src="../../assets/cards/home-recommendation-panel-placeholder.png"
        mode="scaleToFill"
      />
      <view class="recommendation-panel-content recommendation-section panel" data-design-id="index-recommendation-section">
        <view class="section-label recommendation-label recommendation-heading">编辑推荐</view>
        <view class="recommendation-title recommendation-subtitle">先听一段传说，再决定要不要出发</view>

        <view wx:if="{{recommendationLoading}}" class="recommendation-loading">
          <view class="recommendation-skeleton-card">
            <view class="recommendation-skeleton-cover"></view>
            <view class="recommendation-skeleton-content">
              <view class="recommendation-skeleton-line recommendation-skeleton-line--short"></view>
              <view class="recommendation-skeleton-line"></view>
              <view class="recommendation-skeleton-line"></view>
            </view>
          </view>
        </view>

        <view wx:elif="{{recommendationCards.length > 0}}" class="home-recommendation-content">
          <view class="home-recommendation-native">
            <view class="home-recommendation-stage">
              <view class="recommendation-swiper-wrap">
                <swiper
                  class="recommendation-swiper"
                  data-design-id="index-recommendation-swiper"
                  indicator-dots="{{true}}"
                  indicator-color="rgba(139, 94, 52, 0.18)"
                  indicator-active-color="rgba(139, 94, 52, 0.56)"
                  autoplay="{{false}}"
                  circular="{{false}}"
                  display-multiple-items="1"
                  easing-function="easeOutCubic"
                >
                  <swiper-item wx:for="{{recommendationCards}}" wx:key="storyId">
                    <view class="recommendation-slide">
                      <view
                        class="recommendation-card"
                        bindtap="goToRecommendation"
                        data-story-id="{{item.storyId}}"
                        data-design-id="index-recommendation-card"
                        hover-class="recommendation-card-hover"
                      >
                        <image
                          class="recommendation-card-image"
                          src="../../assets/cards/home-recommendation-card-placeholder.png"
                          mode="scaleToFill"
                        />
                        <view class="recommendation-card-content">
                          <view class="recommendation-cover">
                            <image
                              class="recommendation-cover-visual-image"
                              src="../../assets/banners/home-recommendation-cover-placeholder.png"
                              mode="scaleToFill"
                            />
                            <image
                              wx:if="{{item.coverImage}}"
                              class="recommendation-cover-image"
                              src="{{item.coverImage}}"
                              mode="aspectFill"
                            />
                            <view wx:else class="recommendation-cover-placeholder">
                              <view class="recommendation-cover-emoji recommendation-cover-placeholder-icon">📖</view>
                              <view class="recommendation-cover-text recommendation-cover-placeholder-label">传说节选</view>
                            </view>
                          </view>

                          <view class="recommendation-body">
                            <view class="tag recommendation-card-label">{{item.label}}</view>
                            <view class="recommendation-card-title">{{item.displayTitle}}</view>
                            <view class="recommendation-card-location">{{item.locationName}}</view>
                            <view class="recommendation-card-summary">{{item.displaySummary}}</view>
                            <view class="recommendation-card-action">{{item.actionText}}</view>
                          </view>
                        </view>
                      </view>
                    </view>
                  </swiper-item>
                </swiper>
              </view>
            </view>
          </view>

          <view class="home-recommendation-design-canvas">
            <view class="home-recommendation-panel">
              <image
                class="home-recommendation-panel-image"
                src="../../assets/cards/home-recommendation-panel-placeholder.png"
                mode="scaleToFill"
              />
            </view>
            <view
              class="home-recommendation-card recommendation-card"
              bindtap="goToRecommendation"
              data-story-id="{{recommendationCards[0].storyId}}"
              data-design-id="index-recommendation-card"
              hover-class="recommendation-card-hover"
            >
              <image
                class="recommendation-card-image"
                src="../../assets/cards/home-recommendation-card-placeholder.png"
                mode="scaleToFill"
              />
              <view class="recommendation-card-content">
                <view class="recommendation-cover">
                  <image
                    class="recommendation-cover-visual-image"
                    src="../../assets/banners/home-recommendation-cover-placeholder.png"
                    mode="scaleToFill"
                  />
                  <image
                    wx:if="{{recommendationCards[0].coverImage}}"
                    class="recommendation-cover-image"
                    src="{{recommendationCards[0].coverImage}}"
                    mode="aspectFill"
                  />
                  <view wx:else class="recommendation-cover-placeholder">
                    <view class="recommendation-cover-emoji recommendation-cover-placeholder-icon">📖</view>
                    <view class="recommendation-cover-text recommendation-cover-placeholder-label">传说节选</view>
                  </view>
                </view>

                <view class="recommendation-body">
                  <view class="tag recommendation-card-label">{{recommendationCards[0].label}}</view>
                  <view class="recommendation-card-title">{{recommendationCards[0].displayTitle}}</view>
                  <view class="recommendation-card-location">{{recommendationCards[0].locationName}}</view>
                  <view class="recommendation-card-summary">{{recommendationCards[0].displaySummary}}</view>
                  <view class="recommendation-card-action">{{recommendationCards[0].actionText}}</view>
                </view>
              </view>
            </view>
          </view>
        </view>

        <view wx:else class="recommendation-empty">
          <view class="recommendation-empty-text">{{recommendationEmptyText}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="company-footer">深圳市筠竹科技有限公司</view>
</view>
