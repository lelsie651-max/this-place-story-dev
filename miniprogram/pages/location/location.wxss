.location-title {
  margin-top: 18rpx;
  margin-bottom: 12rpx;
}

.detail-card,
.stories-card,
.error-card {
  background: linear-gradient(180deg, rgba(255, 251, 244, 0.98), rgba(249, 240, 226, 0.94));
}

.meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.meta-label {
  color: #8a725c;
  font-size: 26rpx;
}

.meta-value {
  color: #6b4527;
  font-size: 30rpx;
  font-weight: 600;
}

.story-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(140, 94, 52, 0.12);
}

.story-item:first-child {
  padding-top: 8rpx;
}

.story-item:last-child {
  padding-bottom: 0;
  border-bottom: none;
}

.story-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.story-title {
  flex: 1;
  color: #4c3424;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.5;
}

.story-tag {
  flex-shrink: 0;
}

.story-summary {
  color: #6f5740;
  font-size: 28rpx;
  line-height: 1.8;
}
