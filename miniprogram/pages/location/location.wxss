.top-bar {
  margin-bottom: 20rpx;
}

.back-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 144rpx;
  min-height: 72rpx;
  margin: 0;
  padding: 0 28rpx;
  border: 1rpx solid rgba(140, 94, 52, 0.18);
  border-radius: 999rpx;
  background: rgba(255, 247, 235, 0.92);
  color: #6b4527;
  font-size: 28rpx;
  line-height: 72rpx;
  box-shadow: 0 10rpx 24rpx rgba(107, 69, 39, 0.08);
}

.location-title {
  margin-top: 18rpx;
  margin-bottom: 12rpx;
}

.location-hero,
.detail-card,
.meta-card,
.stories-card,
.error-card {
  background: linear-gradient(180deg, rgba(255, 251, 244, 0.98), rgba(249, 240, 226, 0.94));
}

.city-text {
  margin-bottom: 8rpx;
}

.hero-intro {
  color: #6f5740;
  font-size: 30rpx;
  line-height: 1.8;
}

.meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.meta-label {
  color: #8a725c;
  font-size: 26rpx;
}

.meta-value {
  color: #6b4527;
  font-size: 30rpx;
  font-weight: 600;
}

.story-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(140, 94, 52, 0.12);
}

.story-item:first-child {
  padding-top: 8rpx;
}

.story-item:last-child {
  padding-bottom: 0;
  border-bottom: none;
}

.story-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.story-title {
  flex: 1;
  color: #4c3424;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.5;
}

.story-tag {
  flex-shrink: 0;
}

.story-summary {
  color: #6f5740;
  font-size: 28rpx;
  line-height: 1.8;
}

.empty-state {
  padding: 8rpx 0 4rpx;
}

.empty-title {
  margin-bottom: 10rpx;
  color: #4c3424;
  font-size: 32rpx;
  font-weight: 600;
}

.empty-text {
  color: #8a725c;
  font-size: 28rpx;
  line-height: 1.8;
}
