.location-page-header {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: start;
  gap: 12rpx;
  margin-bottom: 30rpx;
  padding-top: 12rpx;
}

.location-page-header-spacer {
  min-width: 0;
}

.location-page-header-copy {
  text-align: center;
}

.hero-title {
  margin-bottom: 16rpx;
  font-size: 68rpx;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: 2rpx;
  color: #412a1f;
  text-align: center;
}

.hero-english {
  display: block;
  margin-bottom: 8rpx;
  color: rgba(139, 94, 52, 0.58);
  font-size: 18rpx;
  font-weight: 400;
  line-height: 1.2;
  letter-spacing: 6rpx;
  text-align: center;
}

.location-magnifying-badge {
  justify-self: end;
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  min-height: 76rpx;
  padding: 0 20rpx;
  border: 1rpx solid rgba(140, 94, 52, 0.16);
  border-radius: 999rpx;
  background: rgba(255, 247, 235, 0.92);
  box-shadow: 0 12rpx 28rpx rgba(107, 69, 39, 0.08);
}

.location-magnifying-icon {
  position: relative;
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
}

.location-magnifying-lens {
  position: absolute;
  top: 0;
  left: 0;
  width: 18rpx;
  height: 18rpx;
  border: 4rpx solid #a36a3a;
  border-radius: 50%;
  background: rgba(255, 248, 236, 0.72);
}

.location-magnifying-handle {
  position: absolute;
  top: 18rpx;
  left: 18rpx;
  width: 14rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #8f5a32, #c2894f);
  transform: rotate(42deg);
  transform-origin: left center;
}

.location-magnifying-count {
  color: #6b4527;
  font-size: 28rpx;
  font-weight: 600;
}

.location-title {
  margin-top: 16rpx;
  margin-bottom: 12rpx;
}

.location-hero,
.stories-card,
.error-card {
  background: linear-gradient(180deg, rgba(255, 251, 244, 0.98), rgba(249, 240, 226, 0.94));
}

.location-hero {
  margin-bottom: 30rpx;
}

.stories-card {
  padding-bottom: 18rpx;
}

.location-address {
  margin-bottom: 8rpx;
}

.story-item {
  margin-top: 20rpx;
  padding: 28rpx 24rpx;
  border: 1rpx solid rgba(140, 94, 52, 0.12);
  border-radius: 24rpx;
  background: rgba(255, 247, 235, 0.72);
}

.story-item:first-child {
  margin-top: 24rpx;
}

.story-item:last-child {
  margin-bottom: 0;
}

.story-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.mode-item {
  position: relative;
  overflow: hidden;
}

.story-title {
  flex: 1;
  color: #4c3424;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.5;
}

.story-tag {
  flex-shrink: 0;
}

.mode-status {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(140, 94, 52, 0.12);
  color: #8b5e34;
  font-size: 24rpx;
  line-height: 1.2;
}

.story-summary {
  color: #6f5740;
  font-size: 28rpx;
  line-height: 1.8;
}

.mode-entry {
  margin-top: 22rpx;
  color: #8b5e34;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.5;
}

.disabled {
  opacity: 0.72;
}

.search-mask {
  position: fixed;
  inset: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(73, 46, 23, 0.42);
  backdrop-filter: blur(6rpx);
}

.search-panel {
  position: relative;
  width: 100%;
  padding: 56rpx 44rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background: linear-gradient(180deg, rgba(255, 250, 241, 0.98), rgba(248, 238, 222, 0.96));
  box-shadow: 0 24rpx 60rpx rgba(73, 46, 23, 0.18);
  text-align: center;
}

.search-glow {
  position: absolute;
  top: -80rpx;
  left: 50%;
  width: 320rpx;
  height: 320rpx;
  margin-left: -160rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(216, 168, 108, 0.38), rgba(216, 168, 108, 0));
  animation: glowPulse 1.8s ease-in-out infinite;
}

.magnifier {
  position: relative;
  width: 220rpx;
  height: 220rpx;
  margin: 10rpx auto 38rpx;
  animation: magnifierMove 1.8s ease-in-out infinite;
}

.magnifier-lens {
  position: absolute;
  top: 16rpx;
  left: 32rpx;
  width: 120rpx;
  height: 120rpx;
  border: 10rpx solid #a36a3a;
  border-radius: 50%;
  background: rgba(255, 248, 236, 0.72);
  box-shadow: inset 0 0 0 4rpx rgba(255, 255, 255, 0.35);
}

.magnifier-handle {
  position: absolute;
  top: 128rpx;
  left: 134rpx;
  width: 72rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #8f5a32, #c2894f);
  transform: rotate(42deg);
  transform-origin: left center;
}

.light-beam {
  position: absolute;
  top: 42rpx;
  left: 62rpx;
  width: 148rpx;
  height: 32rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(255, 224, 169, 0), rgba(255, 224, 169, 0.82), rgba(255, 224, 169, 0));
  transform: rotate(-12deg);
  animation: beamSweep 1.8s ease-in-out infinite;
}

.search-title {
  position: relative;
  color: #5d3a20;
  font-size: 36rpx;
  font-weight: 600;
}

.search-text {
  position: relative;
  margin-top: 18rpx;
  color: #7a6048;
  font-size: 28rpx;
  line-height: 1.8;
}

@keyframes magnifierMove {
  0%,
  100% {
    transform: translateX(-18rpx) rotate(-5deg);
  }

  50% {
    transform: translateX(18rpx) rotate(5deg);
  }
}

@keyframes beamSweep {
  0%,
  100% {
    opacity: 0.35;
    transform: translateX(-18rpx) rotate(-12deg);
  }

  50% {
    opacity: 1;
    transform: translateX(24rpx) rotate(-12deg);
  }
}

@keyframes glowPulse {
  0%,
  100% {
    opacity: 0.45;
    transform: scale(0.92);
  }

  50% {
    opacity: 1;
    transform: scale(1.02);
  }
}
