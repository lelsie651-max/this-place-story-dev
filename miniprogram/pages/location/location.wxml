<view class="page">
  <view class="location-page-header">
    <view class="location-page-header-spacer"></view>
    <view class="location-page-header-copy">
      <view class="hero-title" data-design-id="location-page-title">地点详情</view>
      <view class="section-label hero-english">LOCATION VIEW</view>
    </view>
    <view class="location-magnifying-badge">
      <view class="location-magnifying-icon" aria-hidden="true">
        <view class="location-magnifying-lens"></view>
        <view class="location-magnifying-handle"></view>
      </view>
      <text class="location-magnifying-count">{{remainingMagnifyingGlass}}</text>
    </view>
  </view>

  <block wx:if="{{loading}}">
    <view class="panel">
      <view class="panel-title">正在读取地点</view>
      <view class="panel-text">正在从云端整理地点信息和公开故事，请稍等片刻。</view>
    </view>
  </block>

  <block wx:elif="{{errorMessage}}">
    <view class="panel error-card">
      <view class="panel-title">地点暂时不可用</view>
      <view class="panel-text">{{errorMessage}}</view>
    </view>
  </block>

  <block wx:else>
    <view class="location-hero panel" data-design-id="location-intro-card">
      <view class="tag">{{locationDetail.transientPlace ? '微信地图选点' : '已选地点'}}</view>
      <view class="page-title location-title">{{locationDetail.name}}</view>
      <view class="page-subtitle location-address">{{locationDetail.address || locationDetail.cityText}}</view>
    </view>

    <view class="panel stories-card">
      <view class="panel-title">选择故事类型</view>
      <view class="panel-text">请选择你要搜索的故事类型，每次探索需要消耗1枚放大镜哦！</view>
      <view
        wx:for="{{storyModes}}"
        wx:key="key"
        class="story-item mode-item {{!item.enabled ? 'disabled' : ''}}"
        data-design-id="location-story-option"
        data-type="{{item.key}}"
        data-enabled="{{item.enabled}}"
        data-label="{{item.title}}"
        bindtap="handleSelectStoryType"
      >
        <view class="story-top">
          <view class="story-title">{{item.title}}</view>
          <view wx:if="{{item.statusText}}" class="mode-status">{{item.statusText}}</view>
        </view>
        <view class="story-summary">{{item.description}}</view>
        <view class="mode-entry">{{item.enabled ? '开始探索' : '敬请期待'}}</view>
      </view>
    </view>
  </block>

  <view wx:if="{{requesting}}" class="search-mask" data-design-id="location-loading-overlay">
    <view class="search-panel">
      <view class="search-glow"></view>
      <view class="magnifier">
        <view class="magnifier-lens"></view>
        <view class="magnifier-handle"></view>
        <view class="light-beam"></view>
      </view>
      <view class="search-title">{{requestingHint}}</view>
      <view class="search-text">{{requestingNotice}}</view>
    </view>
  </view>
</view>
