<view class="page">
  <view class="top-bar">
    <button class="back-button" bindtap="goBack">返回</button>
  </view>

  <block wx:if="{{loading}}">
    <view class="section-label">LOCATION VIEW</view>
    <view class="panel">
      <view class="panel-title">正在读取地点</view>
      <view class="panel-text">正在从云端整理地点信息和公开故事，请稍等片刻。</view>
    </view>
  </block>

  <block wx:elif="{{errorMessage}}">
    <view class="section-label">LOCATION VIEW</view>
    <view class="panel error-card">
      <view class="panel-title">地点暂时不可用</view>
      <view class="panel-text">{{errorMessage}}</view>
    </view>
  </block>

  <block wx:else>
    <view class="section-label">LOCATION VIEW</view>
    <view class="location-hero panel">
      <view class="tag">{{locationDetail.transientPlace ? '微信地图选点' : '已选地点'}}</view>
      <view class="page-title location-title">{{locationDetail.name}}</view>
      <view class="page-subtitle city-text">{{locationDetail.cityText}}</view>
      <view class="hero-intro">{{locationDetail.heroIntro}}</view>
    </view>

    <view class="panel detail-card">
      <view class="panel-title">关于这里</view>
      <view class="panel-text">{{locationDetail.intro}}</view>
    </view>

    <view class="panel meta-card">
      <view wx:if="{{locationDetail.transientPlace}}" class="meta-row">
        <text class="meta-label">地点状态</text>
        <text class="meta-value">本次选点临时地点</text>
      </view>
      <view class="meta-row">
        <text class="meta-label">地点线索</text>
        <text class="meta-value">{{locationDetail.tagsText}}</text>
      </view>
      <view class="meta-row">
        <text class="meta-label">{{locationDetail.transientPlace ? '故事状态' : '已发布故事'}}</text>
        <text class="meta-value">{{locationDetail.storyCountText}}</text>
      </view>
      <view class="meta-row">
        <text class="meta-label">放大镜</text>
        <text class="meta-value">{{remainingMagnifyingGlass}} 次</text>
      </view>
    </view>

    <view class="panel stories-card">
      <view class="panel-title">选择故事类型</view>
      <view class="panel-text">
        先选一种讲法，再开始这一轮探索。成功找到一篇故事后，会消耗 1 次放大镜。{{locationDetail.transientPlace ? '当前临时地点只支持民间传说与 AI说，生成结果不会写入正式故事库。': ''}}
      </view>
      <view wx:if="{{travelerEmptyStateVisible}}" class="traveler-empty-card">
        <view class="traveler-empty-title">{{travelerEmptyStateTemporary ? '暂时没有网友提供故事哦！' : '暂时没有网友提供故事哦！'}}</view>
        <view class="traveler-empty-text">{{travelerEmptyStateTemporary ? '这个地点还没有加入地点库，暂时不能投稿。' : '你可以先分享一个版本，审核通过后这里就会出现第一条“网友说”。'}}</view>
        <view class="traveler-empty-actions">
          <button class="traveler-action primary" bindtap="handleShareTravelerStory">我来分享</button>
          <button class="traveler-action" bindtap="goBack">返回</button>
        </view>
      </view>
      <view
        wx:for="{{storyModes}}"
        wx:key="key"
        class="story-item mode-item {{item.featured ? 'featured' : ''}} {{!item.enabled ? 'disabled' : ''}}"
        data-type="{{item.key}}"
        data-enabled="{{item.enabled}}"
        data-label="{{item.title}}"
        bindtap="handleSelectStoryType"
      >
        <view class="story-top">
          <view class="story-title">{{item.title}}</view>
          <view wx:if="{{item.statusText}}" class="mode-status">{{item.statusText}}</view>
          <view wx:elif="{{item.featured}}" class="tag story-tag">推荐</view>
        </view>
        <view class="story-summary">{{item.description}}</view>
        <view class="mode-entry">{{item.enabled ? '开始探索这一类故事' : '敬请期待'}}</view>
      </view>
    </view>
  </block>

  <view wx:if="{{requesting}}" class="search-mask">
    <view class="search-panel">
      <view class="search-glow"></view>
      <view class="magnifier">
        <view class="magnifier-lens"></view>
        <view class="magnifier-handle"></view>
        <view class="light-beam"></view>
      </view>
      <view class="search-title">正在寻找{{requestingTypeLabel}}</view>
      <view class="search-text">
        正沿着地点线索整理一篇可阅读的故事，请稍等片刻。
      </view>
    </view>
  </view>
</view>
