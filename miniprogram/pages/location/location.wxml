<view class="page">
  <view class="top-bar">
    <button class="back-button" bindtap="goBack">返回</button>
  </view>

  <block wx:if="{{loading}}">
    <view class="section-label">LOCATION VIEW</view>
    <view class="panel">
      <view class="panel-title">正在读取地点</view>
      <view class="panel-text">正在从云端整理地点信息和公开故事，请稍等片刻。</view>
    </view>
  </block>

  <block wx:elif="{{errorMessage}}">
    <view class="section-label">LOCATION VIEW</view>
    <view class="panel error-card">
      <view class="panel-title">地点暂时不可用</view>
      <view class="panel-text">{{errorMessage}}</view>
    </view>
  </block>

  <block wx:else>
    <view class="section-label">LOCATION VIEW</view>
    <view class="location-hero panel">
      <view class="tag">地点详情</view>
      <view class="page-title location-title">{{locationDetail.name}}</view>
      <view class="page-subtitle city-text">{{locationDetail.cityText}}</view>
      <view class="hero-intro">{{locationDetail.heroIntro}}</view>
    </view>

    <view class="panel detail-card">
      <view class="panel-title">关于这里</view>
      <view class="panel-text">{{locationDetail.intro}}</view>
    </view>

    <view class="panel meta-card">
      <view class="meta-row">
        <text class="meta-label">故事数量</text>
        <text class="meta-value">{{locationDetail.storyCount}} 篇</text>
      </view>
    </view>

    <view class="panel stories-card">
      <view class="panel-title">发现的故事</view>

      <view wx:if="{{stories.length === 0}}" class="empty-state">
        <view class="empty-title">这里暂时还没有发现故事</view>
        <view class="empty-text">未来会有更多传说被记录在这里。</view>
      </view>

      <view
        wx:for="{{stories}}"
        wx:key="id"
        class="story-item"
        data-story-id="{{item.id}}"
        bindtap="goToStoryDetail"
      >
        <view class="story-top">
          <view class="story-title">{{item.title}}</view>
          <view class="tag story-tag">{{item.typeLabel}}</view>
        </view>
        <view class="story-summary">{{item.summary}}</view>
      </view>
    </view>
  </block>
</view>
